---
// Iconos de redes (iconolinkedin.svg / iconoinstagram.svg), con el color
// heredado del contexto en vez del #232323 original.
interface Props {
  red: 'linkedin' | 'instagram';
  class?: string;
}

const { red, class: className } = Astro.props;

// El marco redondeado es idéntico en ambos.
const marco =
  'M23.78,0h-12.66C4.98,0,0,4.98,0,11.11v12.66c0,6.14,4.98,11.11,11.11,11.11h12.66c6.14,0,11.11-4.98,11.11-11.11v-12.66c0-6.14-4.98-11.11-11.11-11.11ZM31.99,23.78c0,4.53-3.69,8.21-8.21,8.21h-12.66c-4.53,0-8.21-3.69-8.21-8.21v-12.66C2.9,6.58,6.58,2.9,11.11,2.9h12.66c4.53,0,8.21,3.68,8.21,8.21v12.66Z';
---

<svg
  class:list={['icono-red', className]}
  viewBox="0 0 34.89 34.89"
  fill="currentColor"
  aria-hidden="true"
>
  <path d={marco}></path>
  {
    red === 'linkedin' ? (
      <Fragment>
        <rect x="9.67" y="13.71" width="2.91" height="11.2" />
        <path d="M20.75,13.54c-.98,0-1.91.26-2.71.7v-.53h-2.91v11.2h2.91v-5.75c0-1.5,1.22-2.71,2.71-2.71s2.71,1.22,2.71,2.71v5.75h2.91v-5.75c0-3.1-2.52-5.62-5.62-5.62Z" />
        <path d="M11.12,8.32c-1.02,0-1.85.83-1.85,1.85s.83,1.85,1.85,1.85,1.85-.83,1.85-1.85-.83-1.85-1.85-1.85Z" />
      </Fragment>
    ) : (
      <Fragment>
        <path d="M17.45,8.74c-4.8,0-8.71,3.91-8.71,8.71s3.91,8.71,8.71,8.71,8.71-3.91,8.71-8.71-3.91-8.71-8.71-8.71ZM17.45,23.25c-3.2,0-5.8-2.6-5.8-5.8s2.6-5.8,5.8-5.8,5.8,2.6,5.8,5.8-2.6,5.8-5.8,5.8Z" />
        <path d="M26.43,7.04c-.95,0-1.73.77-1.73,1.73s.77,1.73,1.73,1.73,1.73-.77,1.73-1.73-.77-1.73-1.73-1.73Z" />
      </Fragment>
    )
  }
</svg>

<style>
  .icono-red {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

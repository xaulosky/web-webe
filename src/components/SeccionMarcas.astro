---
import Flecha from './Flecha.astro';
import PestanaFlanco from './PestanaFlanco.astro';
import { marcas, MARCA_PORTADA } from '../config/site';

// La primera marca es la que abre destacada. Se muestran todas: la barra
// funciona además como slider cuando no caben.
const pestanas = marcas;
const destacada = 0;

// Una sola imagen por marca: aquí el recuadro es una muestra, no una galería.
// El recorrido completo está en la ficha de cada marca.
// TODO: Rossi aún no manda fotos; mientras tanto muestra la primera de Novara.
const fotoDe = (marca: (typeof marcas)[number]) =>
  marca.fotos[0] ?? '/marcas/fotos/novara-1.webp';

// En la home van las cinco primeras, que son las que definen a la marca; el
// listado completo sigue en la ficha. Una por línea: repartidas en filas se
// leían escalonadas, con los separadores cayendo en sitios distintos según lo
// largo que fuera cada nombre.
const principales = (lista: readonly string[]) => lista.slice(0, 5);

// En la home entran las dos primeras frases. Las descripciones completas rondan
// los 470 caracteres —el doble del texto que dibuja la maqueta— y con la columna
// estrecha del diseño estiraban la ficha hasta dejar la foto casi cuadrada,
// justo lo contrario del «recuadro de la foto podría ser más bajo». La versión
// íntegra se sigue leyendo en la página de cada marca.
const resumen = (texto: string) =>
  texto
    .split(/(?<=\.)\s+/)
    .slice(0, 2)
    .join(' ');
---

{/* data-oculta-logo: aquí el logo del header pisaba el contenido y se retira. */}
<section class="marcas" id="marcas" data-oculta-logo>
  <div class="marcas__intro" data-anima="grupo">
    <p class="marcas__texto">
      Trabajamos con marcas reconocidas por su calidad, innovación y
      confiabilidad, priorizando relaciones de largo plazo que aseguren
      continuidad y respaldo en cada proyecto.
    </p>
  </div>

  <div class="marcas__pestanas" role="tablist" aria-label="Marcas">
    {
      pestanas.map((marca, i) => (
        <button
          type="button"
          class="marcas__pestana"
          role="tab"
          data-marca={i}
          data-slug={marca.slug}
          aria-selected={i === destacada}
        >
          {/* Los flancos con el canto a 18° sólo se ven en la activa; en las
              demás quedan transparentes para no alterar el ancho de la barra. */}
          <span class="marcas__flanco marcas__flanco--izq" aria-hidden="true">
            <PestanaFlanco lado="izquierda" />
          </span>
          <img
            src={`/marcas/${marca.archivo}`}
            alt={marca.nombre}
            width={marca.ancho}
            height={marca.alto}
            loading="lazy"
            decoding="async"
          />
          <span class="marcas__flanco marcas__flanco--der" aria-hidden="true">
            <PestanaFlanco lado="derecha" />
          </span>
        </button>
      ))
    }
  </div>

  <div class="marcas__detalle">
    <div class="marcas__ficha">
      <p class="marcas__antetitulo">marcas destacadas</p>

      {/* Los paneles se apilan en la misma celda: así cruzan en fundido en vez
          de cortar, y la altura la fija el más largo, sin saltos al cambiar. */}
      <div class="marcas__paneles">
      {
        pestanas.map((marca, i) => (
          <div class="marcas__cuerpo" data-panel={i} data-activo={i === destacada ? '' : undefined}>
            <img
              class="marcas__wordmark"
              src={`/marcas/${marca.archivo}`}
              alt={marca.nombre}
              width={marca.ancho}
              height={marca.alto}
              loading="lazy"
              decoding="async"
            />
            <p class="marcas__descripcion">{resumen(marca.descripcion)}</p>
            {marca.categorias.length > 0 && (
              <ul class="marcas__categorias">
                {principales(marca.categorias).map((categoria) => (
                  <li>{categoria}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
      </div>

      <a class="marcas__todas" href={`/marcas/${MARCA_PORTADA}`}>
        Todas las marcas
        <Flecha />
      </a>
    </div>

    {/* Una imagen por marca, sin puntos: el recorrido de fotos vive en la ficha.
        Sólo la marca inicial carga de entrada; el resto lleva la URL en
        data-src y se descarga al seleccionarla. */}
    <div class="marcas__medio" id="marcas-medio" data-anima>
      {
        pestanas.map((marca, i) => (
          <img
            class="marcas__foto"
            src={i === 0 ? fotoDe(marca) : undefined}
            data-src={fotoDe(marca)}
            alt={`Espacio equipado con ${marca.nombre}`}
            width="1200"
            height="960"
            loading="lazy"
            decoding="async"
            data-foto-de={i}
            data-activo={i === 0 ? '' : undefined}
          />
        ))
      }

      {/* La chapa sigue al cursor dentro de la foto; el clic navega. */}
      <a class="marcas__ver" id="marcas-ver" href={`/marcas/${pestanas[destacada].slug}`}>
        <span class="sr-only">Ver marca</span>
        <svg class="marcas__ver-aro" viewBox="0 0 100 100" aria-hidden="true">
          <defs>
            <path id="aro-ver-marca" fill="none" d="M 50,50 m -36,0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0" />
          </defs>
          {/* Tres vueltas en vez de dos y ajustado a la circunferencia exacta
              del aro (2·π·36 ≈ 226): con dos repeticiones el texto llenaba el
              71% y quedaba un hueco. lengthAdjust reparte el sobrante en los
              espacios, no en los glifos, así que las letras no se deforman. */}
          <text textLength="226" lengthAdjust="spacing"
            ><textPath href="#aro-ver-marca"
              >VER MARCA — VER MARCA — VER MARCA — </textPath
            ></text
          >
        </svg>
        <svg class="marcas__ver-flecha" viewBox="0 0 21.84 19.04" fill="currentColor" aria-hidden="true">
          <path d="M21.84,10.99v-.2s0-2.54,0-2.54v-.2c0-.66-.35-1.28-.91-1.62L10.42,0v1.89c0,.66.35,1.28.91,1.62l7.75,4.74H0s0,2.54,0,2.54h19.08s-7.75,4.74-7.75,4.74c-.57.35-.91.96-.91,1.62v1.89s10.51-6.42,10.51-6.42c.57-.35.91-.96.91-1.62Z"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .marcas {
    /* El fondo de la sección es gris; la pestaña activa y su panel son blancos
       y se adelantan sobre él. Un solo token para que no se desincronicen. */
    --panel: #fff;
    /* Un solo gris para la sección y para la barra de pestañas: con dos tonos
       distintos quedaba una costura horizontal en el borde. */
    --fondo: #e9e9e7;
    /* Radio compartido por la pestaña y por sus filetes cóncavos. */
    --r: clamp(0.8rem, 1.6vw, 1.4rem);
    background: var(--fondo);
  }

  /* La intro respira: ocupa casi una pantalla con el texto en el tercio
     central y las pestañas asomando al pie. Lo que debe caber en una pantalla
     es lo de abajo (pestañas + ficha + foto), no esto. */
  .marcas__intro {
    display: grid;
    align-content: center;
    min-height: 76svh;
    padding: clamp(2rem, 6vh, 5rem) clamp(1.5rem, 8vw, 9rem)
      clamp(2rem, 6vh, 5rem) clamp(1.5rem, 16.2vw, 18rem);
  }

  /* En tinta, no en el gris suave: la maqueta lo pone claramente más oscuro
     que el listado de categorías, que sí va en el gris flojo. */
  .marcas__antetitulo {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--color-ink);
  }

  /* Columna estrecha, como el diseño: el párrafo cae a seis líneas y ese
     bloque compacto es justamente la forma que se busca. Mismo cuerpo que el
     texto de «quiénes somos»: son los dos párrafos de apertura del sitio y
     estaban desparejos. */
  .marcas__texto {
    margin: 0;
    max-width: 30ch;
    font-size: clamp(1.25rem, 2.25vw, 2.05rem);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.01em;
  }

  /* --- Barra de pestañas: conjunto centrado, y slider cuando no cabe --- */
  .marcas__pestanas {
    display: flex;
    align-items: stretch;
    justify-content: safe center;
    background: var(--fondo);
    /* Separación entre pestañas: los flancos de la activa salen de su caja y
       sin este hueco se comían el logo de al lado. El padding lateral reserva
       lo mismo para la primera y la última. */
    gap: clamp(1.5rem, 3.2vw, 3.25rem);
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .marcas__pestanas::-webkit-scrollbar {
    display: none;
  }

  .marcas__pestana {
    position: relative;
    flex: 0 1 auto;
    display: grid;
    place-items: center;
    scroll-snap-align: center;
    /* Pestaña baja y con el logo pegado: menos aire en todos los lados. */
    padding: clamp(0.55rem, 1vw, 0.9rem) clamp(0.9rem, 1.8vw, 1.9rem);
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  .marcas__pestana img {
    width: clamp(3rem, 6.4vw, 6.75rem);
    height: auto;
    opacity: 0.45;
    transition: opacity 0.25s ease;
  }

  .marcas__pestana:hover img {
    opacity: 0.7;
  }

  /* La activa es una pestaña de carpeta: fondo claro, esquinas superiores
     redondeadas y filetes cóncavos que la enganchan con la barra. */
  .marcas__pestana[aria-selected='true'] {
    background: var(--panel);
  }

  /* Flancos: fuera del flujo, para que aparecer o desaparecer no mueva la barra.
     El ancho sale del alto (103,02/165), que es lo que fija el ángulo en 18°. */
  .marcas__flanco {
    position: absolute;
    top: 0;
    bottom: 0;
    aspect-ratio: 103.02 / 165;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  /* 1px de solape: el borde del SVG y el de la pestaña son dos blancos que al
     antialiasarse no empalman, y entre ambos asomaba una línea del gris del
     fondo. */
  .marcas__flanco--izq {
    right: calc(100% - 1px);
  }

  .marcas__flanco--der {
    left: calc(100% - 1px);
  }

  .marcas__pestana[aria-selected='true'] .marcas__flanco {
    opacity: 1;
  }

  .marcas__pestana[aria-selected='true'] img {
    opacity: 1;
  }

  /* --- Ficha de la marca destacada --- */
  .marcas__detalle {
    display: grid;
    /* Proporciones medidas sobre la maqueta, en % del ancho de ventana:
       sangría 12, texto 20,7, hueco 8,9, foto 55,6 y canto derecho 2,8.
       Como las columnas y el hueco del grid son relativos al contenedor
       (85,2% de la ventana), aquí van divididos por ese 0,852. */
    grid-template-columns: 24.3% 1fr;
    gap: 10.4%;
    /* stretch, no start: la foto iguala la altura de la ficha y las dos
       columnas cierran a la vez, como en el diseño. */
    align-items: stretch;
    /* Aire arriba y abajo para que el bloque no quede pegado a la barra de
       pestañas ni a la sección siguiente. */
    padding: clamp(2.5rem, 6vh, 5rem) 2.8% clamp(2.5rem, 6.5vh, 5.5rem) 12%;
    background: var(--panel);
  }

  /* Columna en pila para que el enlace pueda irse al pie con margin-top:auto,
     alineado con el canto inferior de la foto como en la maqueta. */
  .marcas__ficha {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Apilados: la altura la fija el panel más largo, así la ficha no da un
     salto cuando se pasa a una marca de texto más corto. */
  .marcas__paneles {
    display: grid;
  }

  /* El relevo es secuencial, no simultáneo: si los dos textos se cruzan al 50%
     se leen superpuestos y eso es lo que se percibe como parpadeo. El saliente
     se va primero y el entrante arranca justo después. */
  .marcas__cuerpo {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.4rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
  }

  .marcas__cuerpo[data-activo] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.3s ease 0.2s,
      transform 0.3s ease 0.2s,
      visibility 0s 0.2s;
  }

  /* En la maqueta el wordmark ocupa el 18,4% del ancho de la ventana y deja
     58px de aire bajo el antetítulo (sobre un lienzo de 1713). */
  .marcas__wordmark {
    width: clamp(8rem, 18.4vw, 18.4rem);
    height: auto;
    margin-top: clamp(1rem, 2.4vw, 2.4rem);
  }

  /* Los huecos verticales salen de la maqueta: 45px bajo el wordmark y 42px
     antes de las categorías, escalados al ancho de ventana. */
  .marcas__descripcion {
    margin: clamp(1rem, 2.6vw, 2.6rem) 0 0;
    /* Con la columna estrecha de la maqueta, el texto real (unos 470 caracteres
       frente a los 230 del lorem ipsum) dispara la ficha y deja la foto casi
       cuadrada. El PDF autoriza «achicar una pizca la tipografía»: a 0.92vw
       cae en diez líneas y la foto recupera su proporción. */
    font-size: clamp(0.78rem, 0.92vw, 0.95rem);
    font-weight: 300;
    line-height: 1.7;
  }

  /* Una por línea: repartidas en filas quedaban escalonadas, con el separador
     cayendo en un sitio distinto según lo largo que fuera cada nombre. */
  .marcas__categorias {
    display: grid;
    gap: 0.3rem;
    margin-top: clamp(1rem, 2.45vw, 2.45rem);
    font-size: 0.8125rem;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* El separador va delante y no detrás: si la lista parte de línea, acompaña a
     su palabra en vez de quedar colgando al final de la anterior. */

  .marcas__todas {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    /* auto: cae al pie de la columna. El mínimo protege el caso en que la
       ficha ya llena todo el alto y no sobra hueco que repartir. */
    margin-top: auto;
    padding-top: clamp(1rem, 2.5vh, 1.9rem);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: gap 0.25s ease;
  }

  .marcas__todas:hover {
    gap: 1.2rem;
  }

  .marcas__todas :global(.flecha) {
    width: 1.1rem;
    opacity: 0.55;
  }

  /* --- Foto: el recuadro tiene su propia proporción y recorta con cover; las fotos de galería vienen en 1200×960 --- */
  .marcas__medio {
    position: relative;
    display: grid;
    overflow: hidden;
    /* Curva discreta: con el radio de las pestañas seguía leyéndose demasiado
       redondeada para una foto de este tamaño. */
    border-radius: clamp(0.5rem, 0.9vw, 0.85rem);
    /* La ficha marca la fila y el recuadro se estira hasta ahí; este suelo
       evita que quede una franja demasiado apaisada frente a la maqueta, que
       la dibuja en torno a 1.5:1. */
    min-height: min(52vh, calc((100vw - 2rem) * 0.56 / 1.62));
    /* La chapa hace de cursor dentro del recuadro. */
    cursor: none;
  }

  /* Absolutas para que su alto intrínseco no imponga la altura de la
     fila; el recorte lo resuelve object-fit. */
  .marcas__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s ease,
      visibility 0.45s;
  }

  /* La que se va no se desvanece: se queda opaca por debajo mientras la nueva
     aparece encima. Cruzando las dos a la vez, en el punto medio ninguna cubre
     del todo y se transparenta el panel blanco de atrás. */
  .marcas__foto[data-saliente] {
    opacity: 1;
    visibility: visible;
    z-index: 0;
    transition: none;
  }

  .marcas__foto[data-activo] {
    z-index: 1;
    opacity: 1;
    visibility: visible;
  }

  /* Chapa "ver marca": sigue al cursor; el JS coloca --x/--y. */
  .marcas__ver {
    position: absolute;
    top: var(--y, 50%);
    left: var(--x, 24%);
    display: grid;
    place-items: center;
    width: clamp(5rem, 7vw, 6.75rem);
    aspect-ratio: 1;
    color: #fff;
    background: rgba(45, 45, 45, 0.32);
    border-radius: 50%;
    backdrop-filter: blur(2px);
    transform: translate(-50%, -50%);
    /* El clic lo captura el recuadro entero; la chapa es el indicador. */
    pointer-events: none;
    z-index: 1;
  }

  .marcas__ver-aro,
  .marcas__ver-flecha {
    grid-area: 1 / 1;
  }

  /* El interletrado lo reparte textLength; aquí sólo manda el cuerpo. */
  .marcas__ver-aro {
    width: 100%;
    height: 100%;
    fill: currentColor;
    font-size: 7.6px;
    font-weight: 400;
    animation: aro-gira 20s linear infinite;
  }

  /* La flecha de marca, apuntando a la derecha. */
  .marcas__ver-flecha {
    width: 20%;
    height: auto;
  }

  @keyframes aro-gira {
    to {
      transform: rotate(360deg);
    }
  }

  /* Portátiles de 768px de alto: con las proporciones de la maqueta el bloque
     no entra en una pantalla, así que ahí se comprime. */
  @media (min-width: 901px) and (max-height: 720px) {
    .marcas__intro {
      min-height: 68svh;
    }

    .marcas__wordmark {
      width: clamp(7rem, 13vw, 13rem);
      margin-top: clamp(0.75rem, 2vw, 2rem);
    }

    .marcas__descripcion {
      margin-top: clamp(0.75rem, 1.6vw, 1.6rem);
      font-size: clamp(0.8rem, 0.92vw, 0.9rem);
      line-height: 1.6;
    }

    .marcas__categorias {
      margin-top: clamp(0.75rem, 1.5vw, 1.5rem);
    }

    .marcas__todas {
      padding-top: clamp(0.75rem, 2vh, 1.5rem);
    }

    /* En pantallas bajas el aire de separación se recorta a la mitad. */
    .marcas__detalle {
      padding-top: clamp(1.25rem, 3vh, 2.25rem);
      padding-bottom: clamp(1.25rem, 3.5vh, 2.5rem);
    }
  }

  @media (max-width: 900px) {
    /* El header flota sobre la sección: sin este respiro el párrafo pasa por
       debajo de la hamburguesa. */
    .marcas__intro {
      padding-top: clamp(4.5rem, 11vh, 6rem);
      padding-right: clamp(4rem, 18vw, 6rem);
    }

    .marcas__detalle {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 2.5rem);
    }

    /* En móvil la foto va arriba del texto, como en el diseño, y se muestra
       cuadrada: a lo ancho de una columna, la franja apaisada del escritorio
       quedaba en una tira de poco más de cien píxeles. */
    .marcas__medio {
      order: -1;
      cursor: auto;
      aspect-ratio: 1;
      min-height: 0;
    }

    /* Los logos de la barra, un punto más grandes. */
    .marcas__pestana img {
      width: clamp(3.75rem, 15vw, 5.5rem);
    }

    .marcas__ver {
      display: none;
    }

    /* La barra es un carrusel: la activa queda centrada y las vecinas asoman. */
    .marcas__pestanas {
      justify-content: flex-start;
      padding-inline: 25%;
      scroll-snap-type: x mandatory;
    }

    .marcas__pestana {
      flex: 0 0 50%;
    }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('.marcas');

  if (seccion) {
    const pestanas = Array.from(seccion.querySelectorAll<HTMLElement>('[data-marca]'));
    const paneles = Array.from(seccion.querySelectorAll<HTMLElement>('[data-panel]'));
    const fotos = Array.from(seccion.querySelectorAll<HTMLImageElement>('[data-foto-de]'));
    const medio = document.getElementById('marcas-medio');
    const ver = document.getElementById('marcas-ver') as HTMLAnchorElement | null;

    let activa = 0;
    // Cada cambio lleva su número: si llegan dos seguidos, el decode del
    // primero no debe activar su foto cuando ya se pidió otra marca.
    let turno = 0;

    const laDe = (indice: number) =>
      fotos.find((img) => Number(img.dataset.fotoDe) === indice);

    // La foto que se va queda de fondo hasta que la nueva termina de entrar.
    let limpiar: ReturnType<typeof setTimeout> | undefined;

    const pintarFotos = () => {
      const saliente = fotos.find((img) => img.hasAttribute('data-activo'));
      const entrante = laDe(activa);
      if (saliente && saliente !== entrante) {
        saliente.setAttribute('data-saliente', '');
      }

      for (const img of fotos) {
        img.toggleAttribute('data-activo', img === entrante);
      }

      clearTimeout(limpiar);
      limpiar = setTimeout(() => {
        for (const img of fotos) {
          if (img !== entrante) img.removeAttribute('data-saliente');
        }
      }, 500);
    };

    // Las fotos de una marca se descargan recién cuando se la selecciona.
    const cargar = (indice: number) => {
      for (const img of fotos) {
        if (Number(img.dataset.fotoDe) === indice && !img.src && img.dataset.src) {
          img.src = img.dataset.src;
        }
      }
    };

    // Deja la imagen pintable antes de cruzarla: activarla sin haber cargado
    // deja el recuadro en blanco un instante, que es el parpadeo.
    const lista = async (img: HTMLImageElement | undefined) => {
      if (!img) return;
      if (!img.src && img.dataset.src) img.src = img.dataset.src;
      if (img.complete && img.naturalWidth > 0) return;
      try {
        await img.decode();
      } catch {
        /* imagen rota o cancelada: seguimos igual, mejor eso que quedar colgado */
      }
    };

    const mostrar = async (indice: number) => {
      const mio = ++turno;

      // La chapa, las pestañas y el texto cambian ya; sólo la foto espera.
      const slug = pestanas[indice]?.dataset.slug;
      if (ver && slug) ver.href = `/marcas/${slug}`;
      pestanas.forEach((pestana, i) => {
        pestana.setAttribute('aria-selected', String(i === indice));
      });
      for (const panel of paneles) {
        panel.toggleAttribute('data-activo', Number(panel.dataset.panel) === indice);
      }

      await lista(laDe(indice));
      if (mio !== turno) return;

      activa = indice;
      cargar(indice);
      pintarFotos();
    };

    pestanas.forEach((pestana, i) => {
      pestana.addEventListener('click', () => {
        mostrar(i);
        // La barra scrollea: dejar la elegida centrada.
        pestana.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      });

      // Al rozar la pestaña ya se va trayendo su primera foto, para que al
      // pulsar el cruce salga inmediato.
      const adelantar = () => lista(laDe(i));
      pestana.addEventListener('pointerenter', adelantar, { once: true });
      pestana.addEventListener('focus', adelantar, { once: true });
    });

    // La chapa sigue al cursor dentro del recuadro; el clic navega, salvo
    // sobre los puntitos.
    if (medio && ver && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      medio.addEventListener('pointermove', (evento) => {
        const caja = medio.getBoundingClientRect();
        ver.style.setProperty('--x', `${evento.clientX - caja.left}px`);
        ver.style.setProperty('--y', `${evento.clientY - caja.top}px`);
      });
      medio.addEventListener('pointerleave', () => {
        ver.style.removeProperty('--x');
        ver.style.removeProperty('--y');
      });
      medio.addEventListener('click', (evento) => {
        if ((evento.target as HTMLElement).closest('button')) return;
        window.location.href = ver.href;
      });
    }

    pintarFotos();
  }
</script>

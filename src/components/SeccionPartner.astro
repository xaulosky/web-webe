---
import BloqueMarco from './BloqueMarco.astro';
import Proceso from './Proceso.astro';
---

<BloqueMarco id="be-partner" antetitulo="be partner">
  Acompañamos a arquitectos, interioristas y empresas en el desarrollo integral
  de proyectos de equipamiento para oficinas. Con un proceso cercano y continuo
  que nos permite transformar cada necesidad en la solución ideal.

  <div slot="extra" class="partner__proceso">
    <Proceso />
  </div>
</BloqueMarco>

<style>
  /* El carrusel sale de la sangría del texto para alinearse con el marco. */
  .partner__proceso {
    margin-top: clamp(3rem, 8vw, 8rem);
    margin-left: clamp(-2rem, -12vw, -1rem);
  }

  @media (max-width: 860px) {
    .partner__proceso {
      margin-left: 0;
    }
  }
</style>

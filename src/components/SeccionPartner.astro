---
import BloqueMarco from './BloqueMarco.astro';
import Proceso from './Proceso.astro';
---

<BloqueMarco id="be-partner">
  Acompañamos a arquitectos, interioristas y empresas en el equipamiento de sus
  espacios de trabajo, con un proceso cercano y continuo que nos permite
  entender cada necesidad y responder con la solución más adecuada.

  <div slot="extra" class="partner__proceso">
    <Proceso />
  </div>
</BloqueMarco>

<style>
  /* El carrusel sale de la sangría del texto para alinearse con el marco. */
  .partner__proceso {
    margin-top: clamp(3rem, 8vw, 8rem);
    margin-left: clamp(-2rem, -12vw, -1rem);
  }

  @media (max-width: 860px) {
    .partner__proceso {
      margin-left: 0;
    }
  }
</style>

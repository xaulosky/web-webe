---
// Corte entre el hero y la sección siguiente: un escalón estrecho y alto. Su
// recorrido completo mide 52 unidades de ancho en 165 de alto —lo medido en el
// diseño— con las dos uniones redondeadas en sentidos opuestos: convexa arriba,
// donde empieza el panel blanco, y cóncava abajo, donde termina el bloque
// oscuro.
//
// El escalón es un SVG de tamaño fijo y proporción intacta, y los tramos planos
// se resuelven con cajas a cada lado. Estirarlo a todo el ancho deformaría los
// radios y cambiaría la inclinación con el viewport.
interface Props {
  /** Dónde queda el canto alto del escalón, en % del ancho. */
  quiebre?: string;
}

const { quiebre = '56.5%' } = Astro.props;
---

<div class="corte" style={`--quiebre:${quiebre}`}>
  {/* Izquierda: transparente, se ve el hero. */}
  <svg
    class="corte__paso"
    viewBox="0 0 80 165"
    width="80"
    height="165"
    preserveAspectRatio="none"
    aria-hidden="true"
    style="display:block"
  >
    <path
      d="M0,165 L8,165 Q20,165 22,153.2 L46,11.8 Q48,0 60,0 L80,0 L80,165 Z"
      fill="#fff"
    ></path>
  </svg>
  <div class="corte__derecha"></div>
</div>

<style>
  .corte {
    /* Manda el alto; el ancho sale de la proporción del escalón. */
    --alto-paso: clamp(5rem, 13.5vh, 11rem);

    position: relative;
    height: var(--alto-paso);
    /* Sin esto, dentro de un contenedor flex se dejaría comprimir. */
    flex: 0 0 auto;
  }

  .corte__paso {
    position: absolute;
    top: 0;
    /* Su borde derecho cae justo en el quiebre. */
    right: calc(100% - var(--quiebre));
    width: calc(var(--alto-paso) * 80 / 165);
    height: 100%;
  }

  .corte__derecha {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: var(--quiebre);
    background: #fff;
  }
</style>

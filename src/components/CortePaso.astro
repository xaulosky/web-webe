---
// Corte entre el hero y la sección siguiente: un escalón. Dos arcos circulares
// de radio 34 en sentidos opuestos —cóncavo abajo, donde termina el bloque
// oscuro, y convexo arriba, donde empieza el panel blanco— unidos por un tramo
// recto a 18° de la vertical, que son los 108° de ángulo interior del diseño.
//
// Los puntos de unión no son a ojo: cada arco gira los 72° que faltan para
// pasar de la tangente horizontal a esa inclinación, así que salen de
// (r·sen72°, alto−r+r·cos72°) y su simétrico. Cambiar el ángulo obliga a
// recalcularlos o los arcos dejan de empalmar sin quiebre con la recta.
//
// El escalón es un SVG de tamaño fijo y proporción intacta, y los tramos planos
// se resuelven con cajas a cada lado. Estirarlo a todo el ancho deformaría los
// radios y cambiaría la inclinación con el viewport.
interface Props {
  /** Dónde queda el canto alto del escalón, en % del ancho. */
  quiebre?: string;
}

const { quiebre = '56.2%' } = Astro.props;
---

<div class="corte" style={`--quiebre:${quiebre}`}>
  {/* Izquierda: transparente, se ve el hero. */}
  <svg
    class="corte__paso"
    viewBox="0 0 118 165"
    width="118"
    height="165"
    preserveAspectRatio="none"
    aria-hidden="true"
    style="display:block"
  >
    <path
      d="M0,165 A34,34 0 0 0 32.34,141.51 L70.68,23.49 A34,34 0 0 1 103.02,0 L118,0 L118,165 Z"
      fill="#fff"
    ></path>
  </svg>
  <div class="corte__derecha"></div>
</div>

<style>
  .corte {
    /* Manda el alto; el ancho sale de la proporción del escalón. Quien lo
       envuelve puede achicarlo con `--paso` —en celu la pestaña va más chica—
       sin que el ángulo cambie: el ancho se recalcula solo. */
    --alto-paso: var(--paso, clamp(5rem, 13.5vh, 11rem));

    position: relative;
    height: var(--alto-paso);
    /* Sin esto, dentro de un contenedor flex se dejaría comprimir. */
    flex: 0 0 auto;
  }

  .corte__paso {
    position: absolute;
    top: 0;
    /* Su borde derecho cae justo en el quiebre. */
    right: calc(100% - var(--quiebre));
    width: calc(var(--alto-paso) * 118 / 165);
    height: 100%;
  }

  /* Solapa 1px con el SVG: los dos bordes caen en coordenadas fraccionarias y
     sin el solape el antialiasing deja una costura de un píxel entre ambos
     blancos. */
  .corte__derecha {
    position: absolute;
    top: 0;
    right: 0;
    bottom: -1px;
    left: calc(var(--quiebre) - 1px);
    background: #fff;
  }
</style>

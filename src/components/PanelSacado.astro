---
import CorteDiagonal from './CorteDiagonal.astro';

// El corte entre la portada y esta sección es una diagonal: la banda blanca
// sube por la derecha y desde ahí el fondo sigue macizo.
interface Props {
  id?: string;
  /** Rótulo chico sobre el texto. Opcional: el copy definitivo los eliminó. */
  antetitulo?: string;
}

const { id, antetitulo } = Astro.props;
---

<section class="sacado" id={id}>
  <div class="sacado__fondo" aria-hidden="true">
    <CorteDiagonal />
    <div class="sacado__relleno"></div>
  </div>

  <div class="sacado__panel" data-anima="grupo">
    {antetitulo && <p class="sacado__antetitulo">{antetitulo}</p>}
    <slot />
  </div>

  <div class="sacado__izquierda" data-anima>
    <slot name="izquierda" />
  </div>
</section>

<style>
  .sacado {
    /* Deja el vértice alto de la diagonal al 78% de la ventana. */
    --solape: 22vh;

    position: relative;
    /* Por encima de un hero pegajoso, que al ser sticky pinta como posicionado. */
    z-index: 1;
    margin-top: calc(-1 * var(--solape));
  }

  .sacado__fondo {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  .sacado__relleno {
    flex: 1;
    background: #fff;
  }

  /* El texto se apoya en la parte alta de la diagonal, a la derecha. */
  .sacado__panel {
    position: relative;
    margin-left: 58.5%;
    padding: 7% 4% clamp(2rem, 4vw, 4rem) 0;
  }

  .sacado__antetitulo {
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--color-muted);
  }

  /* La columna izquierda arranca cuando la diagonal ya dejó paso. */
  .sacado__izquierda {
    position: relative;
    width: 53%;
    padding: 0 clamp(1.5rem, 5vw, 5rem) clamp(2rem, 5vw, 5rem)
      clamp(1.5rem, 8vw, 9rem);
  }

  .sacado__izquierda:empty {
    padding: 0;
  }

  @media (max-width: 860px) {
    .sacado {
      --solape: 10vh;
    }

    .sacado__panel {
      margin-left: 0;
      padding: 11% clamp(1.5rem, 6vw, 2.5rem) clamp(2rem, 6vw, 3rem);
    }

    .sacado__izquierda {
      width: 100%;
      padding: 0 clamp(1.5rem, 6vw, 2.5rem) clamp(2rem, 8vw, 3rem);
    }
  }
</style>

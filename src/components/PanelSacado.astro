---
import CortePaso from './CortePaso.astro';

// El corte entre la portada y esta sección es un escalón con el canto
// inclinado: el blanco entra por la derecha y desde ahí el fondo sigue macizo.
interface Props {
  id?: string;
  /** Rótulo chico sobre el texto. Opcional: el copy definitivo los eliminó. */
  antetitulo?: string;
}

const { id, antetitulo } = Astro.props;
---

<section class="sacado" id={id}>
  <div class="sacado__fondo" aria-hidden="true">
    <CortePaso />
    <div class="sacado__relleno"></div>
  </div>

  {/* Las dos columnas en una misma rejilla: así el texto puede quedarse pegado
      mientras la foto pasa por debajo. Apilados uno tras otro no habría contra
      qué fijarlo. */}
  <div class="sacado__cuerpo">
    <div class="sacado__izquierda" data-anima>
      <slot name="izquierda" />
    </div>

    <div class="sacado__panel" data-anima="grupo">
      {antetitulo && <p class="sacado__antetitulo">{antetitulo}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .sacado {
    /* Deja el vértice alto de la diagonal al 78% de la ventana. */
    --solape: 22vh;

    position: relative;
    /* Por encima de un hero pegajoso, que al ser sticky pinta como posicionado. */
    z-index: 1;
    margin-top: calc(-1 * var(--solape));
  }

  .sacado__fondo {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  /* Sube 1px para solaparse con el escalón: si no, queda una costura entre los
     dos blancos. */
  .sacado__relleno {
    flex: 1;
    margin-top: -1px;
    background: #fff;
  }

  .sacado__cuerpo {
    position: relative;
    display: grid;
    grid-template-columns: 53% 1fr;
    gap: clamp(1.5rem, 5vw, 5rem);
    /* La sección sube --solape sobre lo anterior; el contenido lo descuenta y
       arranca justo debajo del escalón. Sin esto la foto se montaba sobre el
       hero, en la franja donde el blanco todavía no es macizo. */
    padding: calc(var(--solape) + clamp(0.5rem, 1.5vw, 1.5rem))
      clamp(1.5rem, 5vw, 5rem) clamp(2rem, 5vw, 5rem) clamp(1.5rem, 8vw, 9rem);
  }

  /* El texto acompaña la bajada: se queda fijo mientras la foto pasa y se
     suelta cuando la columna termina. `align-self: start` es lo que lo hace
     posible —estirado a toda la fila, sticky no tendría recorrido—. */
  .sacado__panel {
    position: sticky;
    top: clamp(5rem, 11vh, 7rem);
    align-self: start;
    padding-bottom: clamp(2rem, 4vw, 4rem);
  }

  .sacado__antetitulo {
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
    font-size: 0.9375rem;
    font-weight: 300;
    color: var(--color-muted);
  }

  .sacado__izquierda {
    position: relative;
  }

  @media (max-width: 860px) {
    .sacado {
      --solape: 10vh;
    }

    .sacado__panel {
      margin-left: 0;
      padding: 11% clamp(1.5rem, 6vw, 2.5rem) clamp(2rem, 6vw, 3rem);
    }

    .sacado__izquierda {
      width: 100%;
      padding: 0 clamp(1.5rem, 6vw, 2.5rem) clamp(2rem, 8vw, 3rem);
    }
  }
</style>

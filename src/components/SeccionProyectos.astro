---
import { proyectos } from '../config/site';

// El diseño pide como máximo 10 destacados.
const destacados = proyectos.slice(0, 10);

// Tres datos, cada uno con su ícono. Los íconos son provisionales: trazo de
// marca en el mismo estilo que la flecha, hasta que lleguen los definitivos.
const taxonomia = [
  {
    clave: 'superficie',
    rotulo: 'Superficie',
    // Marco con cotas.
    icono: 'M3 7V4h3M18 4h3v3M21 17v3h-3M6 20H3v-3M8 12h8',
  },
  {
    clave: 'puestos',
    rotulo: 'Puestos de trabajo',
    // Silueta y asiento.
    icono: 'M12 4a3 3 0 1 1 0 6 3 3 0 0 1 0-6ZM5 20v-1a7 7 0 0 1 14 0v1',
  },
  {
    clave: 'alcance',
    rotulo: 'Alcance',
    // Capas apiladas.
    icono: 'M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5M3 17.5 12 22l9-4.5',
  },
] as const;
---

<section class="proyectos" id="proyectos" data-fondo="oscuro">
  <video
    class="proyectos__video"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    poster="/media/hero-poster.jpg"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/media/hero.mp4" type="video/mp4" />
  </video>
  <div class="proyectos__scrim" aria-hidden="true"></div>

  <p class="proyectos__antetitulo">proyectos destacados</p>

  {/* Slider horizontal: manda el título que queda centrado. */}
  <div class="proyectos__pista" id="proyectos-pista" data-scroll-propio>
    <ul class="proyectos__titulos">
      {
        destacados.map((proyecto, i) => (
          <li>
            <button
              type="button"
              data-proyecto={i}
              aria-current={i === 0 ? 'true' : undefined}
            >
              {proyecto.nombre}
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dl class="proyectos__ficha">
    {
      taxonomia.map((dato) => (
        <div class="proyectos__dato">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={dato.icono} />
          </svg>
          <dt>{dato.rotulo}:</dt>
          <dd data-campo={dato.clave}>{destacados[0][dato.clave] || '—'}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .proyectos {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: clamp(3rem, 6vh, 5rem) 0 clamp(1.5rem, 4vh, 2.5rem);
    overflow: hidden;
    background: #14140f;
    color: #fff;
  }

  .proyectos__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.3) brightness(0.78) contrast(1.03);
  }

  /* Dos degradados, arriba y abajo: el centro queda limpio para que se lea la
     foto y los extremos dan contraste al texto. */
  .proyectos__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0) 30%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.68) 0%, rgba(0, 0, 0, 0) 28%);
  }

  .proyectos__antetitulo {
    position: relative;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.6);
  }

  /* La pista scrollea sola: data-scroll-propio la exime del suavizado global. */
  .proyectos__pista {
    position: relative;
    width: 100%;
    margin-top: clamp(1rem, 2.5vh, 2rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* Difumina los extremos para que se lea como un carrete. */
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }

  .proyectos__pista::-webkit-scrollbar {
    display: none;
  }

  .proyectos__titulos {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    /* Deja que el primero y el último puedan quedar centrados. */
    padding-inline: 50%;
    width: max-content;
  }

  .proyectos__titulos li {
    scroll-snap-align: center;
  }

  .proyectos__titulos button {
    display: block;
    white-space: nowrap;
    font-size: clamp(1.6rem, 3.1vw, 3.4rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.38);
    cursor: pointer;
    transition: color 0.35s ease;
  }

  .proyectos__titulos button:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .proyectos__titulos button[aria-current] {
    font-weight: 500;
    color: #fff;
  }

  /* --- Los tres datos, en una sola fila --- */
  .proyectos__ficha {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-start;
    width: 100%;
    margin: auto 0 0;
    padding: clamp(1.5rem, 4vh, 2.5rem) clamp(1.5rem, 4vw, 4rem) 0;
    font-size: clamp(0.75rem, 0.95vw, 0.9375rem);
    line-height: 1.5;
  }

  .proyectos__dato {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-inline: clamp(0.75rem, 1.6vw, 1.75rem);
  }

  .proyectos__dato:first-child {
    padding-left: 0;
  }

  /* Filete de separación entre datos, como en el diseño. */
  .proyectos__dato + .proyectos__dato {
    border-left: 1px solid rgba(255, 255, 255, 0.35);
  }

  .proyectos__dato svg {
    align-self: center;
    flex: 0 0 auto;
    width: clamp(0.9rem, 1.1vw, 1.1rem);
    height: auto;
    color: rgba(255, 255, 255, 0.75);
  }

  .proyectos__dato dt {
    font-weight: 500;
    white-space: nowrap;
  }

  .proyectos__dato dd {
    margin: 0;
    font-weight: 300;
  }

  /* El alcance es largo: es el único que puede quedarse con el resto del ancho. */
  .proyectos__dato:last-child {
    flex: 1 1 22rem;
  }

  @media (max-width: 860px) {
    .proyectos {
      padding-top: 7.5rem;
    }

    .proyectos__ficha {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
      padding-inline: clamp(1.5rem, 6vw, 2.5rem);
    }

    .proyectos__dato {
      padding-inline: 0;
    }

    .proyectos__dato + .proyectos__dato {
      border-left: 0;
    }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('.proyectos');
  const pista = document.getElementById('proyectos-pista');

  if (seccion && pista) {
    const botones = Array.from(seccion.querySelectorAll<HTMLElement>('[data-proyecto]'));
    const celdas = Array.from(seccion.querySelectorAll<HTMLElement>('[data-campo]'));
    let actual = 0;

    import('../config/site').then(({ proyectos }) => {
      const destacados = proyectos.slice(0, 10);

      const pintar = (indice: number) => {
        if (indice === actual) return;
        const proyecto = destacados[indice];
        if (!proyecto) return;
        actual = indice;

        for (const boton of botones) {
          const activo = Number(boton.dataset.proyecto) === indice;
          if (activo) boton.setAttribute('aria-current', 'true');
          else boton.removeAttribute('aria-current');
        }
        for (const celda of celdas) {
          const clave = celda.dataset.campo as keyof typeof proyecto;
          // Un dato vacío se muestra como raya, no como celda en blanco.
          celda.textContent = String(proyecto[clave] || '—');
        }
      };

      /* Manda el título que quedó centrado en la pista, no el que se pulsó: así
         los datos de abajo se actualizan mientras se recorre. */
      const centrado = () => {
        const caja = pista.getBoundingClientRect();
        const medio = caja.left + caja.width / 2;
        let mejor = 0;
        let menor = Infinity;

        botones.forEach((boton, i) => {
          const r = boton.getBoundingClientRect();
          const distancia = Math.abs(r.left + r.width / 2 - medio);
          if (distancia < menor) {
            menor = distancia;
            mejor = i;
          }
        });

        pintar(mejor);
      };

      let pedido = false;
      pista.addEventListener(
        'scroll',
        () => {
          if (pedido) return;
          pedido = true;
          requestAnimationFrame(() => {
            pedido = false;
            centrado();
          });
        },
        { passive: true },
      );

      // Al pulsar un título se lo lleva al centro; el scroll hace el resto.
      botones.forEach((boton) => {
        boton.addEventListener('click', () => {
          boton.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
        });
      });

      centrado();
    });

    // El video de fondo sólo corre cuando la sección está a la vista.
    const video = seccion.querySelector<HTMLVideoElement>('.proyectos__video');
    if (video && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (entrada.isIntersecting) {
              if (video.preload === 'none') video.preload = 'auto';
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        },
        { rootMargin: '200px' },
      );
      observador.observe(seccion);
    }
  }
</script>

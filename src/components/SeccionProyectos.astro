---
import { proyectos } from '../config/site';

// Todos los proyectos del array traen fotos: la carpeta define el destacado.
const destacados = proyectos;

// Tres datos, cada uno con su ícono de marca. Cada SVG trae su propio viewBox,
// así que se guarda junto a la trayectoria.
const taxonomia = [
  {
    clave: 'superficie',
    rotulo: 'Superficie',
    vb: '0 0 13.7 13.7',
    icono:
      'M5.57,9,2.1,12.46H5.45v1.2L0,13.7V8.22H1.2l0,3.38L4.71,8.14ZM9,5.57,12.5,2.06l0,3.39h1.2L13.7,0H8.22V1.2h3.42L8.14,4.71Zm3.47,6L9,8.14,8.14,9l3.46,3.47H8.26v1.2l5.44,0V8.22H12.5Zm-7-10.4V0H0L0,5.45h1.2l0-3.39L4.71,5.57l.86-.86L2.06,1.2Z',
  },
  {
    clave: 'puestos',
    rotulo: 'Puestos de trabajo',
    vb: '0 0 14.63 18',
    icono:
      'M12.38,6.75V7.88h.56v2.24h-.67A1.65,1.65,0,0,0,10.69,9H7.88V7.88H9.56a1.65,1.65,0,0,0,1.69-1.69V1.69A1.65,1.65,0,0,0,9.56,0H5.06A1.64,1.64,0,0,0,3.38,1.69v4.5A1.65,1.65,0,0,0,5.06,7.88H6.75V9H3.94a1.64,1.64,0,0,0-1.58,1.12H1.69V7.88h.56V6.75H0V7.88H.56v3.37H2.25v1L6.8,13.39v1.9L2.25,16.42V18H3.38v-.67l3.93-1,3.94,1V18h1.13V16.42L7.93,15.29v-2l4.45-1.12v-.95h1.68V7.88h.56V6.75Zm-7.32,0a.54.54,0,0,1-.56-.56V1.69a.54.54,0,0,1,.56-.57h4.5a.53.53,0,0,1,.56.57v4.5a.53.53,0,0,1-.56.56Zm6.19,4.61-3.94,1-3.93-1v-.67a.53.53,0,0,1,.56-.57h6.75a.54.54,0,0,1,.56.57Z',
  },
  {
    clave: 'alcance',
    rotulo: 'Alcance',
    vb: '0 0 16.95 16.95',
    icono:
      'M8.5,5.31a3.08,3.08,0,0,0-2.26,1A3.07,3.07,0,0,0,5.31,8.5,3.18,3.18,0,0,0,8.5,11.69a3.07,3.07,0,0,0,2.24-.93,3.08,3.08,0,0,0,.95-2.26,3,3,0,0,0-.95-2.24A3,3,0,0,0,8.5,5.31ZM10,10a2,2,0,0,1-1.49.61A2.08,2.08,0,0,1,6.38,8.5,2,2,0,0,1,7,7,2.05,2.05,0,0,1,8.5,6.38,2.15,2.15,0,0,1,10.62,8.5,2.05,2.05,0,0,1,10,10Zm7-.23V7.17l-2.17-.79-.34-.85,1-2.13L13.55,1.54l-2.08,1-.89-.39L9.78,0H7.17L6.38,2.17l-.9.39-2.08-1L1.54,3.4l1,2.08-.39.9L0,7.17V9.78l2.17.8.39.89-1,2.08L3.4,15.41l2.08-1,.9.39L7.17,17H9.78l.8-2.17.89-.39,2.08,1,1.86-1.86-1-2.08.39-.89Zm-2.71-.17L14,9.73l-.75,1.79.85,1.86-.8.8-1.81-.9L9.73,14,9,15.94H7.92L7.22,14l-1.74-.75-1.81.85-.8-.8.85-1.81L3,9.73,1.06,9V8l1.7-.58L3,7.27l.75-1.79L2.87,3.62l.8-.8,1.81.9L7.27,3l.65-1.91H9L9.73,3l1.79.75,1.81-.85.8.8-.85,1.81L14,7.27l1.91.7V9Z',
  },
] as const;
---

<section class="proyectos" id="proyectos" data-fondo="oscuro">
  {/* Fondo: las tres fotos del proyecto activo, en loop automático. Sólo el
      primer proyecto carga de entrada; el resto lleva la URL en data-src y se
      carga recién al seleccionarse, para no bajar 33 fotos de golpe. */}
  <div class="proyectos__fondo" aria-hidden="true">
    {
      destacados.map((proyecto, i) =>
        proyecto.fotos.map((url, j) => (
          <img
            src={i === 0 ? url : undefined}
            data-src={url}
            alt=""
            width="1920"
            height="900"
            loading={i === 0 && j === 0 ? 'eager' : 'lazy'}
            decoding="async"
            data-fondo-de={i}
            data-foto={j}
            data-activa={i === 0 && j === 0 ? '' : undefined}
          />
        )),
      )
    }
  </div>
  <div class="proyectos__scrim" aria-hidden="true"></div>

  <p class="proyectos__antetitulo">proyectos destacados</p>

  {/* Slider horizontal: manda el título que queda centrado. */}
  <div class="proyectos__pista" id="proyectos-pista" data-scroll-propio>
    <ul class="proyectos__titulos">
      {
        destacados.map((proyecto, i) => (
          <li>
            <button
              type="button"
              data-proyecto={i}
              aria-current={i === 0 ? 'true' : undefined}
            >
              {proyecto.nombre}
              {proyecto.ano && <sup>({proyecto.ano.slice(-2)})</sup>}
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  {/* Puntitos de las tres fotos del proyecto activo. */}
  <div class="proyectos__puntos" role="tablist" aria-label="Fotos del proyecto">
    {
      [0, 1, 2].map((j) => (
        <button
          type="button"
          role="tab"
          data-ir-foto={j}
          aria-selected={j === 0}
          aria-label={`Foto ${j + 1}`}
        />
      ))
    }
  </div>

  <dl class="proyectos__ficha">
    {
      taxonomia.map((dato) => (
        <div class="proyectos__dato">
          <svg viewBox={dato.vb} fill="currentColor" aria-hidden="true">
            <path d={dato.icono} />
          </svg>
          <dt>{dato.rotulo}:</dt>
          <dd data-campo={dato.clave}>{destacados[0][dato.clave] || '—'}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .proyectos {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* La sección tiene la proporción de sus fotos (1920×900): más achatada
       que la pantalla completa anterior. El contenido nunca la desborda
       porque min-height:auto la deja crecer si hiciera falta. */
    aspect-ratio: 1920 / 900;
    padding: clamp(2rem, 4vh, 3.5rem) 0 clamp(1.5rem, 3.5vh, 2.5rem);
    overflow: hidden;
    background: #2d2d2d;
    color: #fff;
  }

  .proyectos__fondo {
    position: absolute;
    inset: 0;
  }

  .proyectos__fondo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  .proyectos__fondo img[data-activa] {
    opacity: 1;
  }

  /* Dos degradados, arriba y abajo: el centro queda limpio para que se lea la
     foto y los extremos dan contraste al texto. */
  .proyectos__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0) 30%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.68) 0%, rgba(0, 0, 0, 0) 28%);
  }

  .proyectos__antetitulo {
    position: relative;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.6);
  }

  /* La pista scrollea sola: data-scroll-propio la exime del suavizado global. */
  .proyectos__pista {
    position: relative;
    width: 100%;
    margin-top: clamp(0.75rem, 2vh, 1.5rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* Difumina los extremos para que se lea como un carrete. */
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }

  .proyectos__pista::-webkit-scrollbar {
    display: none;
  }

  .proyectos__titulos {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    /* Deja que el primero y el último puedan quedar centrados. */
    padding-inline: 50%;
    width: max-content;
  }

  .proyectos__titulos li {
    scroll-snap-align: center;
  }

  .proyectos__titulos button {
    display: block;
    white-space: nowrap;
    font-size: clamp(1.5rem, 2.8vw, 3rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.38);
    cursor: pointer;
    transition: color 0.35s ease;
  }

  .proyectos__titulos button:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .proyectos__titulos button[aria-current] {
    font-weight: 500;
    color: #fff;
  }

  .proyectos__titulos button sup {
    font-size: 0.4em;
    font-weight: 300;
    vertical-align: 1.7em;
    margin-left: 0.15em;
  }

  /* --- Puntitos del loop de fotos --- */
  .proyectos__puntos {
    position: relative;
    display: flex;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: clamp(1rem, 3vh, 2rem);
  }

  .proyectos__puntos button {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .proyectos__puntos button[aria-selected='true'] {
    background: #fff;
  }

  /* --- Los tres datos, en una fila centrada --- */
  .proyectos__ficha {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    width: 100%;
    margin: 0;
    padding: clamp(1rem, 2.5vh, 1.75rem) clamp(1.5rem, 4vw, 4rem) 0;
    font-size: clamp(0.75rem, 0.95vw, 0.9375rem);
    line-height: 1.5;
  }

  .proyectos__dato {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-inline: clamp(0.75rem, 1.6vw, 1.75rem);
  }

  /* Filete de separación entre datos, como en el diseño. */
  .proyectos__dato + .proyectos__dato {
    border-left: 1px solid rgba(255, 255, 255, 0.35);
  }

  .proyectos__dato svg {
    align-self: center;
    flex: 0 0 auto;
    width: clamp(0.9rem, 1.1vw, 1.1rem);
    height: auto;
    color: rgba(255, 255, 255, 0.75);
  }

  .proyectos__dato dt {
    font-weight: 500;
    white-space: nowrap;
  }

  .proyectos__dato dd {
    margin: 0;
    font-weight: 300;
  }

  /* El alcance es largo: puede envolver sin estirar la fila entera. */
  .proyectos__dato:last-child {
    flex: 0 1 auto;
    max-width: 44rem;
  }

  @media (max-width: 860px) {
    .proyectos {
      aspect-ratio: auto;
      min-height: 100svh;
      padding-top: 7.5rem;
    }

    .proyectos__ficha {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
      padding-inline: clamp(1.5rem, 6vw, 2.5rem);
    }

    .proyectos__dato {
      padding-inline: 0;
    }

    .proyectos__dato + .proyectos__dato {
      border-left: 0;
    }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('.proyectos');
  const pista = document.getElementById('proyectos-pista');

  if (seccion && pista) {
    const botones = Array.from(seccion.querySelectorAll<HTMLElement>('[data-proyecto]'));
    const celdas = Array.from(seccion.querySelectorAll<HTMLElement>('[data-campo]'));
    const fondos = Array.from(
      seccion.querySelectorAll<HTMLImageElement>('[data-fondo-de]'),
    );
    const puntos = Array.from(seccion.querySelectorAll<HTMLElement>('[data-ir-foto]'));

    let actual = 0;
    let foto = 0;
    let visible = false;
    let reloj = 0;
    /** Lo rellena el import de más abajo; hasta entonces no hay a dónde saltar. */
    let siguienteProyecto = () => {};
    /** Distingue el salto que damos nosotros del que hace el visitante. */
    let saltandoSolo = false;

    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

    const pintarFoto = () => {
      for (const img of fondos) {
        const activa =
          Number(img.dataset.fondoDe) === actual && Number(img.dataset.foto) === foto;
        img.toggleAttribute('data-activa', activa);
      }
      puntos.forEach((punto, j) => punto.setAttribute('aria-selected', String(j === foto)));
    };

    // Las fotos de un proyecto se descargan recién cuando se lo selecciona.
    const cargar = (indice: number) => {
      for (const img of fondos) {
        if (Number(img.dataset.fondoDe) === indice && !img.src && img.dataset.src) {
          img.src = img.dataset.src;
        }
      }
    };

    const reiniciarReloj = () => {
      window.clearInterval(reloj);
      if (sinMovimiento.matches) return;
      // Pasan las tres fotos del proyecto y, cuando se acaban, entra el
      // siguiente proyecto: el recorrido es continuo en vez de quedarse dando
      // vueltas sobre el mismo.
      reloj = window.setInterval(() => {
        if (!visible) return;

        const total = fondos.filter(
          (img) => Number(img.dataset.fondoDe) === actual,
        ).length;

        if (foto < total - 1) {
          foto += 1;
          pintarFoto();
          return;
        }

        siguienteProyecto();
      }, 2400);
    };

    import('../config/site').then(({ proyectos }) => {
      const pintar = (indice: number) => {
        if (indice === actual) return;
        const proyecto = proyectos[indice];
        if (!proyecto) return;
        actual = indice;
        foto = 0;
        cargar(indice);
        pintarFoto();
        reiniciarReloj();

        for (const boton of botones) {
          const activo = Number(boton.dataset.proyecto) === indice;
          if (activo) boton.setAttribute('aria-current', 'true');
          else boton.removeAttribute('aria-current');
        }
        for (const celda of celdas) {
          const clave = celda.dataset.campo as keyof typeof proyecto;
          // Un dato vacío se muestra como raya, no como celda en blanco.
          celda.textContent = String(proyecto[clave] || '—');
        }
      };

      /* El salto automático mueve la pista, no el estado: así el título
         centrado y los datos de abajo siguen saliendo de una sola fuente, que
         es el scroll. Al llegar al último vuelve al primero. */
      siguienteProyecto = () => {
        const destino = (actual + 1) % botones.length;
        saltandoSolo = true;
        botones[destino]?.scrollIntoView({
          inline: 'center',
          block: 'nearest',
          behavior: 'smooth',
        });
        // El scroll suave tarda; el flag se levanta cuando ya llegó.
        window.setTimeout(() => {
          saltandoSolo = false;
        }, 700);
      };

      /* Manda el título que quedó centrado en la pista, no el que se pulsó: así
         los datos de abajo se actualizan mientras se recorre. */
      const centrado = () => {
        const caja = pista.getBoundingClientRect();
        const medio = caja.left + caja.width / 2;
        let mejor = 0;
        let menor = Infinity;

        botones.forEach((boton, i) => {
          const r = boton.getBoundingClientRect();
          const distancia = Math.abs(r.left + r.width / 2 - medio);
          if (distancia < menor) {
            menor = distancia;
            mejor = i;
          }
        });

        pintar(mejor);
      };

      let pedido = false;
      pista.addEventListener(
        'scroll',
        () => {
          if (pedido) return;
          pedido = true;
          requestAnimationFrame(() => {
            pedido = false;
            centrado();
            // Si el que mueve la pista es el visitante, el reloj vuelve a
            // empezar: no tiene sentido que le cambiemos el proyecto debajo
            // mientras recorre.
            if (!saltandoSolo) reiniciarReloj();
          });
        },
        { passive: true },
      );

      // Al pulsar un título se lo lleva al centro; el scroll hace el resto.
      botones.forEach((boton) => {
        boton.addEventListener('click', () => {
          boton.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
        });
      });

      centrado();
    });

    // Los puntitos saltan a una foto concreta y reinician el reloj.
    puntos.forEach((punto, j) => {
      punto.addEventListener('click', () => {
        foto = j;
        pintarFoto();
        reiniciarReloj();
      });
    });

    // El loop sólo corre con la sección a la vista.
    const observador = new IntersectionObserver(
      ([entrada]) => {
        visible = entrada.isIntersecting;
      },
      { rootMargin: '100px' },
    );
    observador.observe(seccion);

    reiniciarReloj();
  }
</script>

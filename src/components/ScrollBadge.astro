<style>
  .badge {
    display: block;
    width: clamp(6rem, 9vw, 8.25rem);
    aspect-ratio: 1;
    color: #fff;
    transition: opacity 0.3s ease;
  }

  .badge:hover {
    opacity: 0.7;
  }

  .badge__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* view-box hace que 50% 50% sea el centro del viewBox, no el del trazo. */
  .badge__ring {
    transform-box: view-box;
    transform-origin: 50% 50%;
    animation: badge-spin 22s linear infinite;
  }

  .badge__arrow {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: badge-bob 2.4s ease-in-out infinite;
  }

  @keyframes badge-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes badge-bob {
    0%,
    100% {
      transform: translateY(-10%);
    }
    50% {
      transform: translateY(10%);
    }
  }
</style>

---
// Botón de descarga tal cual lo entregó el diseño: el SVG trae el marco de
// canto diagonal, el icono y el rótulo ya vectorizados, así que se usa entero
// en vez de rearmarlo con texto HTML encima —que es justo lo que el PDF pedía
// corregir («usar el botón en SVG, porque se ve raro»)—.
import svgCrudo from '../assets/boton-catalogo.svg?raw';

interface Props {
  href?: string;
  /** Sin archivo se dibuja igual pero inactivo, para no ofrecer una descarga
   *  que no existe. */
  inactivo?: boolean;
  etiqueta?: string;
}

const { href, inactivo = false, etiqueta = 'Descargar catálogo' } = Astro.props;

// El original viene con un gris fijo; heredando el color, el estado inactivo y
// el hover se resuelven desde el CSS sin tocar el trazado.
const svg = svgCrudo
  .replace(/\.cls-1\s*\{[^}]*\}/, '.cls-1{fill:currentColor;}')
  .replace('<svg', '<svg class="descarga__grafico" aria-hidden="true" focusable="false"');

// Sin archivo no es un enlace: un <a> sin href no es accesible ni navegable.
const apagado = inactivo || !href;
const Elemento = apagado ? 'span' : 'a';
---

<Elemento
  class="descarga"
  href={apagado ? undefined : href}
  download={apagado ? undefined : true}
  aria-disabled={apagado ? 'true' : undefined}
  title={apagado ? 'Catálogo pendiente' : undefined}
>
  {/* El rótulo va vectorizado dentro del SVG: aquí queda el texto de verdad
      para lectores de pantalla y buscadores. */}
  <span class="sr-only">{etiqueta}</span>
  <Fragment set:html={svg} />
</Elemento>

<style>
  .descarga {
    display: block;
    width: clamp(10.5rem, 14.5vw, 13.5rem);
    color: var(--color-ink);
    transition: color 0.25s ease;
  }

  .descarga__grafico {
    display: block;
    width: 100%;
    height: auto;
  }

  a.descarga:hover {
    color: var(--color-muted);
  }

  /* Inactivo se dibuja igual de oscuro que activo: en gris parecía apagado al
     lado de las otras fichas. Lo que avisa de que no hay archivo es el cursor
     y el title, no el color. */
  .descarga[aria-disabled='true'] {
    cursor: not-allowed;
  }
</style>

---
import CorteDiagonal from './CorteDiagonal.astro';
import Flecha from './Flecha.astro';

interface Props {
  id?: string;
}

const { id = 'descubre' } = Astro.props;
---

<section class="nosotros" id={id}>
  {/* El fondo blanco entra con la diagonal y sigue macizo hacia abajo. */}
  <div class="nosotros__fondo" aria-hidden="true">
    <CorteDiagonal />
    <div class="nosotros__relleno"></div>
  </div>

  <div class="nosotros__panel" data-anima="grupo">
    <p class="nosotros__antetitulo">Quiénes somos</p>

    <p class="nosotros__texto">
      Somos una empresa especializada en mobiliario y equipamiento de oficinas
      que entiende que los espacios influyen en la forma en que las personas
      trabajan, colaboran y se relacionan.
    </p>

    <a class="nosotros__cta" href="/nosotros">
      Descubre más.
      {/* El contenedor fija el tamaño: el SVG de marca es width:100% y una
          regla con alcance de componente no lo alcanza desde aquí. */}
      <span class="nosotros__cta-flecha"><Flecha /></span>
    </a>
  </div>
</section>

<style>
  .nosotros {
    /* Cuánto sube la sección sobre el hero: deja el vértice alto de la
       diagonal al 78% de la ventana, como en el diseño. */
    --solape: 22vh;

    position: relative;
    /* Por encima del hero pegajoso, que al ser sticky pinta como posicionado. */
    z-index: 1;
    margin-top: calc(-1 * var(--solape));
  }

  .nosotros__fondo {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  .nosotros__relleno {
    flex: 1;
    background: #fff;
  }

  /* El contenido se apoya en la parte alta de la diagonal, a la derecha. */
  .nosotros__panel {
    position: relative;
    margin-left: 58.5%;
    padding: 7% 4% clamp(3rem, 6vw, 6rem) 0;
  }

  /* Mismo tamaño y color que los botones del sitio, como pide el diseño. */
  .nosotros__antetitulo {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .nosotros__texto {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    font-size: clamp(1.25rem, 2.25vw, 2.05rem);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.01em;
  }

  .nosotros__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: gap 0.25s ease;
  }

  .nosotros__cta:hover {
    gap: 1.1rem;
  }

  .nosotros__cta-flecha {
    display: block;
    width: 1rem;
    opacity: 0.55;
  }

  /* En móvil la diagonal queda muy plana para dividir columnas: el texto pasa
     a ocupar todo el ancho, debajo del corte. */
  @media (max-width: 860px) {
    .nosotros {
      --solape: 10vh;
    }

    .nosotros__panel {
      margin-left: 0;
      padding: 11% clamp(1.5rem, 6vw, 2.5rem) clamp(2.5rem, 8vw, 4rem);
    }
  }
</style>

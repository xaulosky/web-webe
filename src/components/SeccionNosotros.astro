---
import CortePaso from './CortePaso.astro';
import Flecha from './Flecha.astro';

interface Props {
  id?: string;
}

const { id = 'descubre' } = Astro.props;
---

<section class="nosotros" id={id}>
  {/* El fondo blanco entra con el escalón y sigue macizo hacia abajo. */}
  <div class="nosotros__fondo" aria-hidden="true">
    <CortePaso />
    <div class="nosotros__relleno"></div>
  </div>

  {/* Sin data-anima: su entrada la marca el scroll del hero (--sale-hero) y
      sumar el revelado genérico encima daba dos animaciones a la vez. */}
  <div class="nosotros__panel">
    <p class="nosotros__antetitulo">Quiénes somos</p>

    <p class="nosotros__texto">
      Nos especializamos en mobiliario y equipamiento de oficinas. Creemos que
      los espacios influyen en la forma en que las personas trabajan, colaboran
      y se relacionan.
    </p>

    <a class="nosotros__cta" href="/nosotros">
      Conócenos
      {/* El contenedor fija el tamaño: el SVG de marca es width:100% y una
          regla con alcance de componente no lo alcanza desde aquí. */}
      <span class="nosotros__cta-flecha"><Flecha /></span>
    </a>
  </div>
</section>

<style>
  .nosotros {
    /* Cuánto sube la sección sobre el hero: deja el vértice alto de la
       diagonal al 78% de la ventana, como en el diseño. */
    --solape: 22vh;

    position: relative;
    /* Por encima del hero pegajoso, que al ser sticky pinta como posicionado. */
    z-index: 1;
    margin-top: calc(-1 * var(--solape));
  }

  .nosotros__fondo {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  /* Sube 1px para solaparse con el escalón: si no, queda una costura entre los
     dos blancos. */
  .nosotros__relleno {
    flex: 1;
    margin-top: -1px;
    background: #fff;
  }

  /* El contenido se apoya en la parte alta de la diagonal, a la derecha, y
     entra acompañando el final del hero: `--sale-hero` lo publica el scrub del
     titular, así que el texto sube y aparece mientras el hero se apaga, en vez
     de esperar a estar en pantalla para revelarse por su cuenta. */
  .nosotros__panel {
    position: relative;
    margin-left: 58.5%;
    padding: 7% 4% clamp(3rem, 6vw, 6rem) 0;
    opacity: var(--sale-hero, 1);
    transform: translateY(calc((1 - var(--sale-hero, 1)) * 2.5rem));
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .nosotros__panel {
      opacity: 1;
      transform: none;
    }
  }

  /* Mismo tamaño y color que los botones del sitio, como pide el diseño. */
  .nosotros__antetitulo {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .nosotros__texto {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    font-size: clamp(1.25rem, 2.25vw, 2.05rem);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.01em;
  }

  .nosotros__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: gap 0.25s ease;
  }

  .nosotros__cta:hover {
    gap: 1.1rem;
  }

  .nosotros__cta-flecha {
    display: block;
    width: 1rem;
    opacity: 0.55;
  }

  /* En móvil la diagonal queda muy plana para dividir columnas: el texto pasa
     a ocupar todo el ancho, debajo del corte. */
  @media (max-width: 860px) {
    .nosotros {
      --solape: 10vh;
      /* Pestaña más chica en celu, igual que en el resto de los cortes. */
      --paso: clamp(3rem, 8vh, 5rem);
    }

    /* Descuenta el solape y el escalón: sin esto el antetítulo caía dentro de
       la diagonal, sobre la franja donde todavía se ve el hero. */
    .nosotros__panel {
      margin-left: 0;
      padding: calc(var(--solape) + var(--paso) + clamp(1.5rem, 6vw, 2.5rem))
        clamp(1.5rem, 6vw, 2.5rem) clamp(2.5rem, 8vw, 4rem);
    }
  }
</style>

---
// El panel blanco sube por la derecha y se monta sobre el hero: el "sacado"
// es la esquina superior izquierda redondeada recortando el video.
interface Props {
  id?: string;
}

const { id = 'descubre' } = Astro.props;
---

<section class="nosotros" id={id}>
  <div class="nosotros__panel" data-anima="grupo">
    <p class="nosotros__antetitulo">Quiénes somos</p>
    <p class="nosotros__texto">
      Somos una empresa especializada en mobiliario y equipamiento de oficinas
      que entiende que los espacios influyen en la forma en que las personas
      trabajan, colaboran y se relacionan.
    </p>
    <a class="nosotros__cta" href="/nosotros">
      Conócenos
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .nosotros {
    --radio: clamp(2.5rem, 4.2vw, 4.75rem);
    /* Cuánto sube el panel sobre el hero. El borde inferior del bloque oscuro
       queda exactamente a esta distancia del techo de la sección. */
    --solape: 28vh;

    position: relative;
    /* Por encima del hero pegajoso, que al ser sticky pinta como posicionado. */
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    margin-top: calc(-1 * var(--solape));
  }

  /* Filete que redondea la esquina inferior derecha del bloque oscuro, donde
     se encuentra con el canto izquierdo del panel. */
  .nosotros::before {
    content: '';
    position: absolute;
    top: calc(var(--solape) - var(--radio));
    right: 47%;
    width: var(--radio);
    height: var(--radio);
    background: radial-gradient(
      circle at 0 0,
      transparent var(--radio),
      #fff calc(var(--radio) + 0.5px)
    );
  }

  .nosotros__panel {
    width: 47%;
    background: #fff;
    border-top-left-radius: var(--radio);
    /* Panel más bajo: el diseño lo quiere en poco más de la mitad del alto que
       tenía, así que el aire vertical baja de 14rem a 6rem. */
    padding: clamp(1.75rem, 2.6vw, 2.75rem) clamp(1.5rem, 3.2vw, 3.5rem)
      clamp(2rem, 3.2vw, 3.25rem) clamp(2rem, 4vw, 4.5rem);
  }

  /* Mismo tamaño y color que los botones (CONÓCENOS, TODAS LAS MARCAS). */
  .nosotros__antetitulo {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .nosotros__texto {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    max-width: 31ch;
    font-size: clamp(1.25rem, 2.25vw, 2.05rem);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.01em;
  }

  .nosotros__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: gap 0.25s ease;
  }

  .nosotros__cta:hover {
    gap: 0.9rem;
  }

  .nosotros__cta svg {
    width: 1rem;
    height: 1rem;
  }

  /* En móvil el panel ocupa todo el ancho: el sacado no tiene sentido. */
  @media (max-width: 860px) {
    .nosotros {
      --solape: 12vh;
    }

    .nosotros::before {
      display: none;
    }

    .nosotros__panel {
      width: 100%;
      border-top-left-radius: clamp(1.75rem, 6vw, 3rem);
      border-top-right-radius: clamp(1.75rem, 6vw, 3rem);
    }
  }
</style>

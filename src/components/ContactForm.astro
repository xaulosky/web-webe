---
import { CONTACT_ENDPOINT } from '../config/site';

const campo =
  'mt-1.5 w-full rounded-lg border border-black/10 bg-white px-3.5 py-2.5 text-sm outline-none transition-colors placeholder:text-black/35 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 disabled:opacity-60';
const etiqueta = 'block text-sm font-medium';
---

<form
  id="form-contacto"
  action={CONTACT_ENDPOINT}
  method="POST"
  novalidate
  class="space-y-5"
>
  <!-- Honeypot: invisible para personas, tentador para bots. El PHP descarta
       el envío si viene con contenido. -->
  <div aria-hidden="true" class="absolute left-[-9999px] h-0 w-0 overflow-hidden">
    <label>
      No llenar este campo
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div>
    <label for="nombre" class={etiqueta}>Nombre</label>
    <input
      type="text"
      id="nombre"
      name="nombre"
      required
      maxlength="80"
      autocomplete="name"
      placeholder="Tu nombre"
      class={campo}
    />
    <p class="mt-1 hidden text-xs text-red-600" data-error-for="nombre"></p>
  </div>

  <div>
    <label for="email" class={etiqueta}>Email</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      maxlength="120"
      autocomplete="email"
      placeholder="tu@correo.cl"
      class={campo}
    />
    <p class="mt-1 hidden text-xs text-red-600" data-error-for="email"></p>
  </div>

  <div>
    <label for="mensaje" class={etiqueta}>Mensaje</label>
    <textarea
      id="mensaje"
      name="mensaje"
      required
      rows="5"
      maxlength="2000"
      placeholder="Cuéntanos en qué te podemos ayudar"
      class={campo}></textarea>
    <p class="mt-1 hidden text-xs text-red-600" data-error-for="mensaje"></p>
  </div>

  <button
    type="submit"
    class="w-full rounded-lg bg-brand-700 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-800 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
  >
    Enviar mensaje
  </button>

  <p
    id="form-estado"
    role="status"
    aria-live="polite"
    class="hidden rounded-lg px-4 py-3 text-sm"
  >
  </p>
</form>

<script>
  const form = document.getElementById('form-contacto') as HTMLFormElement | null;
  const estado = document.getElementById('form-estado') as HTMLParagraphElement | null;
  if (!form || !estado) throw new Error('form-contacto no encontrado');

  const boton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const textoBoton = boton.textContent ?? '';

  const mostrarError = (campo: string, mensaje: string) => {
    const p = form.querySelector<HTMLElement>(`[data-error-for="${campo}"]`);
    const input = form.elements.namedItem(campo) as HTMLInputElement | null;
    if (p) {
      p.textContent = mensaje;
      p.classList.toggle('hidden', !mensaje);
    }
    input?.setAttribute('aria-invalid', mensaje ? 'true' : 'false');
  };

  const limpiarErrores = () => {
    for (const campo of ['nombre', 'email', 'mensaje']) mostrarError(campo, '');
    estado.className = 'hidden rounded-lg px-4 py-3 text-sm';
  };

  const avisar = (mensaje: string, ok: boolean) => {
    estado.textContent = mensaje;
    estado.className = ok
      ? 'rounded-lg bg-green-50 px-4 py-3 text-sm text-green-800'
      : 'rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700';
  };

  const validar = (datos: FormData) => {
    let ok = true;
    const nombre = String(datos.get('nombre') ?? '').trim();
    const email = String(datos.get('email') ?? '').trim();
    const mensaje = String(datos.get('mensaje') ?? '').trim();

    if (nombre.length < 2) {
      mostrarError('nombre', 'Ingresa tu nombre.');
      ok = false;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      mostrarError('email', 'Ingresa un email válido.');
      ok = false;
    }
    if (mensaje.length < 10) {
      mostrarError('mensaje', 'El mensaje debe tener al menos 10 caracteres.');
      ok = false;
    }
    return ok;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    limpiarErrores();

    const datos = new FormData(form);
    if (!validar(datos)) {
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    boton.disabled = true;
    boton.textContent = 'Enviando…';

    try {
      const respuesta = await fetch(form.action, {
        method: 'POST',
        body: datos,
        headers: { Accept: 'application/json' },
      });
      const resultado = await respuesta.json().catch(() => ({}) as Record<string, unknown>);

      if (respuesta.ok && resultado.ok) {
        form.reset();
        avisar(
          typeof resultado.message === 'string'
            ? resultado.message
            : '¡Gracias! Recibimos tu mensaje y te responderemos pronto.',
          true,
        );
      } else {
        // El PHP puede devolver errores por campo: { errors: { email: "..." } }
        const errores = resultado.errors;
        if (errores && typeof errores === 'object') {
          for (const [campo, texto] of Object.entries(errores)) {
            mostrarError(campo, String(texto));
          }
        }
        avisar(
          typeof resultado.message === 'string'
            ? resultado.message
            : 'No pudimos enviar tu mensaje. Inténtalo de nuevo.',
          false,
        );
      }
    } catch {
      avisar('Hubo un problema de conexión. Inténtalo de nuevo en unos minutos.', false);
    } finally {
      boton.disabled = false;
      boton.textContent = textoBoton;
    }
  });
</script>

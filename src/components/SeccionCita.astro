---
// Banda con video de fondo y la cita centrada encima.
---

<section class="cita">
  <video
    class="cita__video"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    poster="/media/cita-poster.jpg"
    aria-hidden="true"
    tabindex="-1"
  >
    {/* Mismo criterio que el hero: vertical en pantallas altas y estrechas,
        WebM primero y MP4 de respaldo para el Safari sin VP9. */}
    <source src="/media/cita-vertical.webm" type="video/webm" media="(max-aspect-ratio: 3/4)" />
    <source src="/media/cita.webm" type="video/webm" />
    <source src="/media/cita-vertical.mp4" type="video/mp4" media="(max-aspect-ratio: 3/4)" />
    <source src="/media/cita.mp4" type="video/mp4" />
  </video>
  <div class="cita__scrim" aria-hidden="true"></div>

  <blockquote class="cita__texto" data-anima>
    <p>
      <span class="cita__comilla">&ldquo;</span>El espacio que diseñas merece{' '}
      <strong>el mobiliario</strong> que <strong>escogerías para tí</strong><span
        class="cita__comilla">&rdquo;</span
      >.
    </p>
  </blockquote>
</section>

<style>
  .cita {
    position: relative;
    display: grid;
    place-items: center;
    /* Banda, no pantalla completa: la proporción del diseño es ~2.2:1.
       El ancho tiene que ser explícito: si sólo se declara aspect-ratio y una
       min-height, la altura queda definida y el navegador deduce el ancho al
       revés (352px × 2.2 = 774px), ensanchando la página entera. */
    width: 100%;
    aspect-ratio: 2.2 / 1;
    min-height: 22rem;
    overflow: hidden;
    background: #2d2d2d;
    color: #fff;
  }

  .cita__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Apenas lo justo para que el blanco no se pierda sobre las zonas claras. */
  .cita__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.12) 0%,
      rgba(0, 0, 0, 0.24) 45%,
      rgba(0, 0, 0, 0.12) 100%
    );
  }

  .cita__texto {
    position: relative;
    margin: 0;
    padding-inline: 1.5rem;
    /* Medida ajustada para que "que" caiga en la tercera línea, como el diseño. */
    max-width: clamp(18rem, 46vw, 62rem);
    text-align: center;
  }

  .cita__texto p {
    margin: 0;
    font-size: clamp(1.5rem, 4.2vw, 4rem);
    font-weight: 300;
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.4);
  }

  .cita__texto strong {
    font-weight: 500;
  }

  /* Las comillas no deben empujar el bloque fuera del centro óptico. */
  .cita__comilla {
    display: inline-block;
    margin-inline: -0.08em;
  }
</style>

<script>
  // El video sólo se carga cuando la banda se acerca a pantalla, y se pausa
  // cuando sale: es decorativo y no vale gastar batería ni datos de más.
  const seccion = document.querySelector<HTMLElement>('.cita');
  const video = seccion?.querySelector<HTMLVideoElement>('.cita__video');
  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (seccion && video) {
    if (sinMovimiento.matches) {
      video.removeAttribute('autoplay');
    } else {
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (entrada.isIntersecting) {
              if (video.preload === 'none') video.preload = 'auto';
              video.play().catch(() => {
                /* Si el navegador lo bloquea queda el poster. */
              });
            } else {
              video.pause();
            }
          }
        },
        { rootMargin: '200px' },
      );
      observador.observe(seccion);
    }
  }
</script>

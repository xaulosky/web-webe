---
import ScrollBadge from './ScrollBadge.astro';
import { marcas } from '../config/site';

interface Props {
  /** Ancla a la que salta el badge circular. */
  scrollTo?: string;
}

const { scrollTo = '#descubre' } = Astro.props;
---

{/* Sin JS la pista de scroll no anima nada: sobra y estorba. */}
<noscript>
  <style>
    .hero-wrap {
      height: 100svh !important;
    }
  </style>
</noscript>

<div class="hero-wrap" id="hero-wrap">
  <section class="hero">
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/media/hero-poster.jpg"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__stage">
      <h1 class="hero__title" id="hero-title">
        {/* Los separadores son espacios de verdad (&nbsp;) en spans propios: así
            el titular se sigue leyendo "we create, be yourself." para buscadores
            y lectores de pantalla, pero su ancho es animable hasta cero. */}
        <span class="hero__morph" id="hero-morph"><span class="hero__word hero__word--keep"
            >we</span
          ><span class="hero__space" data-shrink>&nbsp;</span><span
            class="hero__word hero__word--drop"
            data-shrink
            data-fade><span class="hero__tinta">create,</span></span
          ><span class="hero__space" data-shrink>&nbsp;</span><span
            class="hero__word hero__word--keep">be</span
          ><span class="hero__space" data-shrink>&nbsp;</span><span
            class="hero__word hero__word--drop"
            data-shrink
            data-fade><span class="hero__tinta">yourself.</span></span
          ><span class="hero__tm">™</span></span
        >
      </h1>
    </div>

    <p class="hero__claim" id="hero-claim">
        <span class="hero__claim-line"
          >Equipamiento <span class="hero__claim-strong">integral</span></span
        >
        <span class="hero__claim-line"
          >para <span class="hero__claim-strong">oficinas.</span></span
        >
      </p>

    <ul class="hero__marcas" id="hero-marcas" aria-label="Marcas que representamos">
      {
        marcas.map((marca) => (
          <li style={`--ancho:${marca.escala}`}>
            {/* Sobre el video va la versión blanca oficial. */}
            <img
              src={`/marcas/${marca.blanco}`}
              alt={marca.nombre}
              width={marca.ancho}
              height={marca.alto}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>

    <div class="hero__badge" id="hero-badge">
      <ScrollBadge href={scrollTo} />
    </div>
  </section>
</div>

<style>
  /* El wrapper alto es la pista de scroll que scrubea la animación; el hero
     queda pegado arriba mientras dura. */
  .hero-wrap {
    position: relative;
    height: 250vh;
  }

  .hero {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #2d2d2d;
    color: #fff;
    /* El bloque de fase 2 va más adentro que el navbar, como en el diseño. */
    --sangria-fase2: clamp(1.5rem, 16.4vw, 20rem);
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* El material original es muy luminoso; esto lo lleva al look del diseño. */
    /* Arranca luminoso y se va apagando con el scroll, para que el claim de
       la fase 2 tenga contraste. */
    filter: saturate(0.32) sepia(0.1) brightness(calc(0.88 - 0.3 * var(--oscurecer, 0)))
      contrast(1.04);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.4) 0%,
        rgba(0, 0, 0, 0.2) 38%,
        rgba(0, 0, 0, 0.24) 62%,
        rgba(0, 0, 0, 0.44) 100%
      ),
      rgba(24, 22, 16, 0.2);
  }

  .hero__stage {
    position: relative;
    width: 100%;
  }

  .hero__title {
    margin: 0;
    text-align: center;
    font-size: clamp(2.5rem, 12.5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.3);
  }

  .hero__morph {
    display: inline-block;
    transform-origin: left top;
    will-change: transform;
  }

  /* Todas con vertical-align:top: un inline-block con overflow oculto alinea
     por su borde inferior y rompería la línea base si se mezclaran. */
  .hero__word {
    display: inline-block;
    vertical-align: top;
    white-space: nowrap;
  }

  .hero__word--keep {
    font-weight: 500;
  }

  /* Palabras que desaparecen: se desvanecen y el JS colapsa su ancho.
     El padding con margen negativo compensado da aire para que el recorte
     no coma las astas ni las colas (la "y" de yourself). */
  .hero__word--drop {
    overflow: hidden;
    font-weight: 300;
    padding: 0.2em 0 0.35em;
    margin-top: -0.2em;
    margin-bottom: -0.35em;
    opacity: calc(1 - var(--fade, 0));
  }

  /* El texto de las palabras que caen se desplaza a la izquierda mientras su
     máscara se cierra: se ocultan hacia la izquierda, no recortadas a la
     derecha. */
  .hero__tinta {
    display: inline-block;
    will-change: transform;
  }

  /* Los espacios entre palabras se encogen igual que las palabras. */
  .hero__space {
    display: inline-block;
    vertical-align: top;
    overflow: hidden;
    white-space: pre;
  }

  .hero__tm {
    font-size: 0.24em;
    font-weight: 300;
    vertical-align: 1.9em;
    letter-spacing: 0;
  }

  @media (min-width: 768px) {
    .hero__title {
      /* Una sola línea que ocupa casi todo el ancho, como en el diseño. */
      font-size: min(8.05vw, 11rem);
      line-height: 0.98;
      white-space: nowrap;
    }
  }

  /* En móvil el titular va arriba y también en una sola línea: a 7vw ocupa
     ~83% del ancho, igual que en el diseño, y aguanta hasta 320px. */
  @media (max-width: 767px) {
    .hero {
      align-items: flex-start;
      padding-top: 11vh;
    }

    .hero__title {
      font-size: 7.6vw;
      line-height: 1.1;
      white-space: nowrap;
    }

    .hero__claim {
      top: 52%;
      font-size: 8.6vw;
    }
  }

  /* --- Fase 2: el claim aparece cuando el logo ya aterrizó --- */
  .hero__claim {
    position: absolute;
    top: 55%;
    left: var(--sangria-fase2);
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: clamp(2rem, 6.1vw, 5.75rem);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.3);
    opacity: var(--claim-in, 0);
    transform: translateY(calc(-50% + (1 - var(--claim-in, 0)) * 1.5rem));
    pointer-events: none;
  }

  .hero__claim-strong {
    font-weight: 500;
  }

  /* Fila de marcas representadas, alineada con el claim. */
  .hero__marcas {
    position: absolute;
    bottom: 14%;
    left: var(--sangria-fase2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* El grupo se lee centrado dentro de su caja. */
    justify-content: center;
    gap: clamp(0.9rem, 2vh, 1.5rem) clamp(1rem, 1.85vw, 2rem);
    /* Ajustado para que corte después de bkcontract: 4 marcas arriba, 2 abajo. */
    max-width: min(30rem, 27vw);
    opacity: var(--marcas-in, 0);
    transform: translateY(calc((1 - var(--marcas-in, 0)) * 1rem));
    pointer-events: none;
  }

  .hero__marcas li {
    display: flex;
    /* Un pelo más chicos, para que el grupo se lea centrado y compacto. */
    width: clamp(2.5rem, calc(var(--ancho) * 0.88vw), 6.25rem);
  }

  .hero__marcas img {
    width: 100%;
    height: auto;
    opacity: 0.55;
  }

  /* Posición por defecto (táctil, sin puntero fino): abajo al centro. */
  .hero__badge {
    position: absolute;
    bottom: clamp(2.5rem, 12vh, 7rem);
    left: 50%;
    transform: translateX(-50%);
  }

  /* Con mouse el badge ES el cursor: se oculta el puntero del sistema y el
     badge lo persigue. */
  @media (hover: hover) and (pointer: fine) {
    .hero {
      cursor: none;
    }

    .hero__badge {
      position: fixed;
      top: 0;
      left: 0;
      bottom: auto;
      z-index: 30;
      pointer-events: none;
      will-change: transform;
      transition: opacity 0.25s ease;
    }
  }

  /* Con el menú abierto el badge se transparentaría a través del overlay.
     Y al ser fijo, hay que retirarlo cuando el hero deja de estar a la vista. */
  :root[data-menu='abierto'] .hero__badge,
  .hero__badge[data-fuera] {
    opacity: 0;
    pointer-events: none;
  }

  /* Sin JS o con movimiento reducido no hay scrub: el hero se comporta como
     una portada normal de una sola pantalla. */
  @media (prefers-reduced-motion: reduce) {
    .hero-wrap {
      height: auto;
    }

    .hero {
      position: relative;
    }
  }
</style>

<script>
  const wrap = document.getElementById('hero-wrap');
  const hero = document.querySelector<HTMLElement>('.hero');
  const morph = document.getElementById('hero-morph');
  const title = document.getElementById('hero-title');
  const claim = document.getElementById('hero-claim');
  const marcasEl = document.getElementById('hero-marcas');
  const header = document.querySelector<HTMLElement>('.site-header');
  const headerLogo = document.getElementById('header-logo');
  const video = document.querySelector<HTMLVideoElement>('.hero__video');

  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

  /** Progreso normalizado de `a` a `b`, recortado a 0..1. */
  const tramo = (p: number, a: number, b: number) =>
    Math.min(1, Math.max(0, (p - a) / (b - a)));

  const suavizar = (t: number) => t * t * (3 - 2 * t);

  if (wrap && morph && title && claim && header && headerLogo) {
    // Palabras que caen + los espacios que las separan: todo lo que se encoge.
    const encogibles = Array.from(morph.querySelectorAll<HTMLElement>('[data-shrink]'));
    let anchos: number[] = [];

    let dx = 0;
    let dy = 0;
    let escala = 1;

    /**
     * FLIP: mide dónde queda "webe™" ya colapsado y a tamaño de hero, y lo
     * compara con el hueco del logo en el navbar. De ahí salen el
     * desplazamiento y la escala exactos del final de la animación.
     */
    const medir = () => {
      // Ancho natural de cada pieza que va a desaparecer.
      for (const pieza of encogibles) pieza.style.width = '';
      anchos = encogibles.map((pieza) => pieza.getBoundingClientRect().width);

      // Estado final (colapsado, sin transform) para leer su geometría real.
      const transformPrevio = morph.style.transform;
      morph.style.transform = 'none';
      for (const pieza of encogibles) pieza.style.width = '0px';

      const fin = morph.getBoundingClientRect();

      // Un span vacío alineado a la línea base delata dónde está esa línea:
      // la caja de texto incluye interlineado y el SVG del logo no, así que
      // centrar cajas dejaría el logo desalineado unos píxeles.
      const testigo = document.createElement('span');
      testigo.style.cssText = 'display:inline-block;width:0;height:0;vertical-align:baseline';
      morph.appendChild(testigo);
      const lineaBase = testigo.getBoundingClientRect().top;
      testigo.remove();

      morph.style.transform = transformPrevio;

      const destino = headerLogo.getBoundingClientRect();
      if (!fin.width || !destino.width) return;

      escala = destino.width / fin.width;
      dx = destino.left - fin.left;
      // El viewBox del logo llega hasta la línea base salvo el desborde de las
      // curvas (44.89 de 45.34).
      dy =
        destino.top +
        destino.height * (44.89 / 45.34) -
        (fin.top + (lineaBase - fin.top) * escala);
    };

    // Sólo en dev: ?p=0.4 congela la animación en ese punto para revisarla
    // sin tener que acertarle al scroll. Vite lo elimina del build.
    // Ojo: get() devuelve null si el parámetro no está, y Number(null) es 0,
    // no NaN; sin este chequeo el scrub se quedaría congelado en 0.
    const parametroP = import.meta.env.DEV
      ? new URLSearchParams(location.search).get('p')
      : null;
    const forzado = parametroP === null ? NaN : Number(parametroP);

    const pintar = () => {
      const recorrido = wrap.offsetHeight - window.innerHeight;
      const p = Number.isFinite(forzado)
        ? forzado
        : recorrido > 0
          ? Math.min(1, Math.max(0, -wrap.getBoundingClientRect().top / recorrido))
          : 0;

      // 1. Las palabras se van y el bloque se junta. La tinta de las que caen
      //    se corre a la izquierda al ritmo del cierre: el enmascarado las
      //    oculta hacia la izquierda.
      const cierre = suavizar(tramo(p, 0.02, 0.3));
      title.style.setProperty('--fade', String(tramo(p, 0, 0.16)));
      encogibles.forEach((pieza, i) => {
        pieza.style.width = `${(anchos[i] ?? 0) * (1 - cierre)}px`;
        const tinta = pieza.querySelector<HTMLElement>('.hero__tinta');
        if (tinta) tinta.style.transform = `translateX(${-(anchos[i] ?? 0) * cierre}px)`;
      });

      // 2. El bloque viaja al navbar en dos tiempos: primero se va del todo
      //    hacia la izquierda y recién después sube. Los tramos se solapan un
      //    poco para que el giro no se sienta como dos movimientos pegados.
      const viajeX = suavizar(tramo(p, 0.12, 0.34));
      const viajeY = suavizar(tramo(p, 0.28, 0.44));
      const encoge = suavizar(tramo(p, 0.12, 0.4));
      morph.style.transform = `translate(${dx * viajeX}px, ${dy * viajeY}px) scale(${
        1 + (escala - 1) * encoge
      })`;

      // 3. Relevo entre el texto y el logo oficial del navbar.
      const relevo = tramo(p, 0.36, 0.44);
      title.style.opacity = String(1 - relevo);
      header.style.setProperty('--logo-opacity', String(relevo));
      header.dataset.morph = relevo >= 1 ? 'done' : 'running';

      // 4. Fase 2: el video se apaga, luego el claim, luego las marcas.
      hero?.style.setProperty('--oscurecer', String(suavizar(tramo(p, 0.1, 0.6))));
      claim.style.setProperty('--claim-in', String(suavizar(tramo(p, 0.45, 0.62))));
      marcasEl?.style.setProperty('--marcas-in', String(suavizar(tramo(p, 0.56, 0.74))));
    };

    if (sinMovimiento.matches) {
      // Sin scrub: el navbar muestra el logo desde el principio.
      header.style.setProperty('--logo-opacity', '1');
      header.dataset.morph = 'done';
    } else {
      let pedido = false;
      const alScroll = () => {
        if (pedido) return;
        pedido = true;
        requestAnimationFrame(() => {
          pedido = false;
          pintar();
        });
      };

      const recalcular = () => {
        medir();
        pintar();
      };

      // Las medidas dependen de la tipografía ya cargada.
      document.fonts.ready.then(recalcular);
      recalcular();

      window.addEventListener('scroll', alScroll, { passive: true });
      window.addEventListener('resize', recalcular);
    }
  }

  // El video queda como imagen fija si el usuario pidió menos movimiento.
  const aplicarVideo = () => {
    if (!video) return;
    if (sinMovimiento.matches) {
      video.pause();
      video.removeAttribute('autoplay');
    } else {
      video.play().catch(() => {
        /* Si el navegador bloquea el autoplay queda el poster. */
      });
    }
  };

  aplicarVideo();
  sinMovimiento.addEventListener('change', aplicarVideo);
</script>

<script>
  // El badge circular hace de cursor dentro del hero: el puntero del sistema
  // se oculta (cursor:none en CSS) y el badge lo persigue con retardo.
  const hero = document.querySelector<HTMLElement>('.hero');
  const badge = document.getElementById('hero-badge');
  const enlace = badge?.querySelector('a');

  const conPuntero = window.matchMedia('(hover: hover) and (pointer: fine)');
  const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && badge && enlace) {
    // Posición de reposo: abajo al centro, como en el diseño. El badge sólo
    // abandona ese punto mientras el puntero está sobre el hero.
    const reposo = () => ({ x: window.innerWidth / 2, y: window.innerHeight * 0.8 });

    let destinoX = reposo().x;
    let destinoY = reposo().y;
    let x = destinoX;
    let y = destinoY;
    let bucle = 0;
    let siguiendo = false;

    const colocar = () => {
      badge.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
    };

    const animar = () => {
      // Sin retardo si el usuario pidió menos movimiento.
      const seguimiento = menosMovimiento.matches ? 1 : 0.2;
      x += (destinoX - x) * seguimiento;
      y += (destinoY - y) * seguimiento;
      colocar();
      // Al volver al reposo no hace falta seguir gastando frames.
      if (!siguiendo && Math.abs(destinoX - x) < 0.5 && Math.abs(destinoY - y) < 0.5) {
        x = destinoX;
        y = destinoY;
        colocar();
        bucle = 0;
        return;
      }
      bucle = requestAnimationFrame(animar);
    };

    const arrancar = () => {
      if (!bucle) bucle = requestAnimationFrame(animar);
    };

    const alMover = (evento: PointerEvent) => {
      if (!conPuntero.matches) return;
      siguiendo = true;
      destinoX = evento.clientX;
      destinoY = evento.clientY;
      arrancar();
    };

    const volverAlReposo = () => {
      siguiendo = false;
      const r = reposo();
      destinoX = r.x;
      destinoY = r.y;
      arrancar();
    };

    hero.addEventListener('pointermove', alMover);
    hero.addEventListener('pointerleave', volverAlReposo);
    window.addEventListener('resize', () => {
      if (!siguiendo) {
        const r = reposo();
        destinoX = x = r.x;
        destinoY = y = r.y;
        colocar();
      }
    });

    // Con el badge convertido en cursor, el hero entero es el disparador.
    hero.addEventListener('click', (evento) => {
      if (!conPuntero.matches) return;
      if ((evento.target as HTMLElement).closest('a, button')) return;
      document.querySelector(enlace.getAttribute('href') ?? '')?.scrollIntoView({
        behavior: menosMovimiento.matches ? 'auto' : 'smooth',
      });
    });

    // Teclado: al enfocar el enlace lo devolvemos al reposo, que es donde se ve.
    enlace.addEventListener('focus', volverAlReposo);

    // Al pasar a táctil el badge vuelve a su sitio fijo del CSS.
    const alCambiarPuntero = () => {
      if (conPuntero.matches) {
        colocar();
      } else {
        if (bucle) cancelAnimationFrame(bucle);
        bucle = 0;
        badge.style.transform = '';
      }
    };

    conPuntero.addEventListener('change', alCambiarPuntero);
    alCambiarPuntero();

    // El badge es fixed: sin esto se quedaría flotando sobre el resto del sitio.
    const vigia = new IntersectionObserver(
      ([entrada]) => {
        badge.toggleAttribute('data-fuera', !entrada.isIntersecting);
      },
      { threshold: 0.15 },
    );
    vigia.observe(hero);
  }
</script>

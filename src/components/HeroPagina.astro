---
// Portada de páginas interiores: foto a sangre y titular abajo a la izquierda,
// con la misma mezcla de pesos de la marca.
interface Props {
  imagen: string;
  alt: string;
  /** Cada línea puede llevar sólo una de las dos partes. */
  lineas: readonly { readonly fuerte?: string; readonly suave?: string }[];
  ancho?: number;
  alto?: number;
  /** Encuadre alternativo para pantallas angostas, si la foto ancha no sirve. */
  imagenAngosta?: string;
}

const { imagen, alt, lineas, ancho = 1900, alto = 943, imagenAngosta } = Astro.props;
---

<section class="portada">
  {/* Una portada a sangre recorta muchísimo: lo que en escritorio es un plano
      general, en celu se convierte en un primer plano. Cuando hay un encuadre
      hecho para vertical, se usa ese. */}
  <picture>
    {imagenAngosta && <source srcset={imagenAngosta} media="(max-width: 860px)" />}
    <img class="portada__foto" src={imagen} alt={alt} width={ancho} height={alto} fetchpriority="high" />
  </picture>
  <div class="portada__scrim" aria-hidden="true"></div>

  <h1 class="portada__titulo" data-anima="portada">
    {
      lineas.map((linea) => (
        <span class="portada__linea">
          {linea.fuerte && <span class="portada__fuerte">{linea.fuerte}</span>}
          {linea.fuerte && linea.suave && ' '}
          {linea.suave && <span class="portada__suave">{linea.suave}</span>}
        </span>
      ))
    }
  </h1>
</section>

<style>
  .portada {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding: 0 clamp(1.5rem, 6vw, 7rem) clamp(6rem, 20vh, 14rem)
      clamp(1.5rem, 17.2vw, 19rem);
    overflow: hidden;
    background: #2d2d2d;
    color: #fff;
  }

  .portada__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portada__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.12) 45%,
      rgba(0, 0, 0, 0.3) 100%
    );
  }

  .portada__titulo {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 0;
    font-size: clamp(2.25rem, 4.55vw, 4.75rem);
    line-height: 1.14;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
  }

  .portada__fuerte {
    font-weight: 500;
  }

  .portada__suave {
    font-weight: 300;
  }

  @media (max-width: 767px) {
    .portada {
      padding-bottom: 26vh;
    }

    .portada__titulo {
      font-size: 9vw;
    }
  }
</style>

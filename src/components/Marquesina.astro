---
import { marquesina } from '../config/site';

interface Props {
  frases?: readonly { readonly fuerte: string; readonly suave: string }[];
}

const { frases = marquesina } = Astro.props;

// Decorativa: se duplica la secuencia para que el bucle no tenga costura
// (la pista recorre exactamente la mitad de su ancho y vuelve a empezar).
const pista = [...frases, ...frases];
---

<div class="marquesina" aria-hidden="true">
  <div class="marquesina__pista">
    {
      pista.map((frase) => (
        <span class="marquesina__frase">
          <span class="marquesina__fuerte">{frase.fuerte}</span>{' '}
          <span class="marquesina__suave">{frase.suave}</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquesina {
    overflow: hidden;
    padding-block: clamp(2rem, 6vw, 6rem);
    user-select: none;
  }

  .marquesina__pista {
    display: flex;
    width: max-content;
    animation: correr 34s linear infinite;
  }

  .marquesina__frase {
    padding-right: 0.35em;
    font-size: clamp(3rem, 10.4vw, 11rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    white-space: nowrap;
    /* Gris propio del titular grande: el #969696 de los textos suaves pesaba
       demasiado a este tamaño. */
    color: #d5d5d5;
  }

  .marquesina__fuerte {
    font-weight: 500;
  }

  .marquesina__suave {
    font-weight: 300;
  }

  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquesina__pista {
      animation: none;
    }
  }
</style>

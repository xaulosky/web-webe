---
// Corte entre el hero y la sección siguiente: la banda blanca sube por la
// derecha con una diagonal a 18,3° respecto de la horizontal (los 71,5° del
// diseño medidos desde la vertical) y las uniones redondeadas.
//
// El viewBox es 1404×125, así que la diagonal arranca al 27% del ancho y
// termina al 54%, y su altura es el 8,9% del ancho. Al fijar esa misma
// proporción en el elemento, el `preserveAspectRatio="none"` no deforma nada y
// el ángulo se mantiene en cualquier viewport.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* Las dimensiones van en atributos y estilo en línea a propósito: una regla
    de estilo con alcance de componente no llega a este SVG cuando se usa desde
    otro componente, y el SVG caía a su tamaño por defecto de 300px. */}
<svg
  class:list={['corte', className]}
  viewBox="0 0 1404 125"
  width="1404"
  height="125"
  preserveAspectRatio="none"
  aria-hidden="true"
  style="display:block;width:100%;height:auto;flex:0 0 auto"
>
  {/* Vértices en x=380 y x=757. El redondeo consume 20 unidades a cada lado:
      con más, el recorrido total se alarga y la diagonal se ve más plana que
      los 18,3° del tramo recto. */}
  <path
    d="M0,125 L360,125 Q380,125 399,118.7 L738,6.3 Q757,0 777,0 L1404,0 L1404,125 Z"
    fill="#fff"
  ></path>
</svg>


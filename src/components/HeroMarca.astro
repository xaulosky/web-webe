---
import { marcas } from '../config/site';

// Portada de la página de marca: foto a sangre y una pestaña blanca abajo a la
// izquierda con el wordmark. El resto de las marcas quedan fantasma sobre la
// foto, a la misma altura, y llevan a su propia página.
interface Props {
  slug: string;
  foto: string;
}

const { slug, foto } = Astro.props;
const activa = marcas.find((marca) => marca.slug === slug)!;
const otras = marcas.filter((marca) => marca.slug !== slug);
---

<section class="marca-portada" data-fondo="oscuro">
  <img
    class="marca-portada__foto"
    src={foto}
    alt={`Espacio equipado con ${activa.nombre}`}
    width="1920"
    height="650"
    fetchpriority="high"
  />
  <div class="marca-portada__scrim" aria-hidden="true"></div>

  {/* Pestaña y logos en una misma fila: con la pestaña posicionada aparte y
      los logos a un `left` fijo, el hueco entre ambos cambiaba según lo ancho
      que fuera cada wordmark. */}
  <div class="marca-portada__pie">
    <div class="marca-portada__pestana" data-anima="portada">
      <img
        class="marca-portada__wordmark"
        src={`/marcas/${activa.archivo}`}
        alt={activa.nombre}
        width={activa.ancho}
        height={activa.alto}
      />
    </div>

    <nav class="marca-portada__otras" aria-label="Otras marcas">
      {
        otras.map((marca) => (
          <a href={`/marcas/${marca.slug}`}>
            {/* Sobre la foto va la versión blanca oficial. */}
            <img
              src={`/marcas/${marca.blanco}`}
              alt={marca.nombre}
              width={marca.ancho}
              height={marca.alto}
              loading="lazy"
            />
          </a>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .marca-portada {
    --radio: clamp(1.75rem, 3.2vw, 3.5rem);

    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(70vh, 42rem);
    color: #fff;
    background: #2d2d2d;
  }

  .marca-portada__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* La banda baja se oscurece más: ahí van los logos blancos y con fotos
     claras (Trisoft, Belgotex) se perdían del todo. */
  .marca-portada__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.22) 0%,
      rgba(0, 0, 0, 0.06) 40%,
      rgba(0, 0, 0, 0.34) 72%,
      rgba(0, 0, 0, 0.62) 100%
    );
  }

  /* La fila del pie ocupa el ancho y reparte: pestaña a la izquierda, logos
     llenando lo que queda hasta el canto derecho. */
  .marca-portada__pie {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
  }

  /* Las marcas inactivas arrancan justo a la derecha de la pestaña —el diseño
     las quiere pegadas a ella, no descolgadas— y se reparten hasta el borde.
     Cuando no caben, la fila hace de slider. */
  .marca-portada__otras {
    flex: 1;
    display: flex;
    /* Los logos se apoyan en la misma línea de base que el wordmark de la
       pestaña: por eso el padding inferior es el mismo que el suyo. */
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(0.75rem, 2vw, 2.25rem);
    padding: 0 clamp(1.5rem, 3vw, 3rem) clamp(1.1rem, 2.2vw, 2.1rem)
      clamp(1rem, 2.5vw, 2.5rem);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .marca-portada__otras::-webkit-scrollbar {
    display: none;
  }

  .marca-portada__otras a {
    flex: 0 0 auto;
    scroll-snap-align: center;
  }

  .marca-portada__otras img {
    /* Una pizca más chicos, como la barra de pestañas de la portada. */
    width: clamp(3rem, 5.4vw, 5.75rem);
    height: auto;
    opacity: 0.72;
    /* Son logos blancos sobre foto: el degradado general no basta cuando la
       imagen tiene claros justo detrás (Trisoft, Belgotex). La sombra los
       despega de cualquier fondo. */
    filter: drop-shadow(0 1px 7px rgba(0, 0, 0, 0.6));
    transition: opacity 0.25s ease;
  }

  .marca-portada__otras a:hover img {
    opacity: 0.9;
  }

  /* Pestaña de carpeta: blanca, esquinas superiores redondeadas y filetes
     cóncavos que la enganchan con el blanco de la página. */
  /* Pestaña más baja y más ceñida al wordmark, como pide el diseño. */
  .marca-portada__pestana {
    position: relative;
    flex: none;
    margin-left: clamp(1.5rem, 4.7vw, 5rem);
    padding: clamp(1.1rem, 2.2vw, 2.1rem) clamp(1.5rem, 3.4vw, 3.6rem);
    background: #fff;
    border-radius: var(--radio) var(--radio) 0 0;
  }

  .marca-portada__pestana::before,
  .marca-portada__pestana::after {
    content: '';
    position: absolute;
    bottom: 0;
    width: var(--radio);
    height: var(--radio);
  }

  .marca-portada__pestana::before {
    right: 100%;
    background: radial-gradient(
      circle at 0 0,
      transparent var(--radio),
      #fff calc(var(--radio) + 0.5px)
    );
  }

  .marca-portada__pestana::after {
    left: 100%;
    background: radial-gradient(
      circle at 100% 0,
      transparent var(--radio),
      #fff calc(var(--radio) + 0.5px)
    );
  }

  .marca-portada__wordmark {
    display: block;
    width: clamp(8rem, 17vw, 17rem);
    height: auto;
  }

  @media (max-width: 860px) {
    .marca-portada {
      min-height: min(60vh, 30rem);
    }

    /* No caben seis logos junto a la pestaña: se van sobre la foto, arriba, y
       corren en horizontal. */
    .marca-portada__pie {
      display: block;
    }

    .marca-portada__otras {
      position: absolute;
      right: 0;
      left: 0;
      top: clamp(5rem, 12vh, 7rem);
      justify-content: flex-start;
      max-width: 100%;
      padding: 0 clamp(1.5rem, 6vw, 2.5rem);
    }

    .marca-portada__otras::-webkit-scrollbar {
      display: none;
    }

    .marca-portada__otras img {
      width: 4.25rem;
    }

    .marca-portada__pestana {
      margin-left: clamp(1rem, 4vw, 2rem);
      padding-inline: clamp(1.5rem, 6vw, 2.5rem);
    }
  }
</style>

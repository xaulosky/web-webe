---
import PestanaFlanco from './PestanaFlanco.astro';
import { marcas } from '../config/site';

// Portada de la página de marca: foto a sangre y una pestaña blanca abajo a la
// izquierda con el wordmark. El resto de las marcas quedan fantasma sobre la
// foto, a la misma altura, y llevan a su propia página.
interface Props {
  slug: string;
  foto: string;
}

const { slug, foto } = Astro.props;
const activa = marcas.find((marca) => marca.slug === slug)!;
const otras = marcas.filter((marca) => marca.slug !== slug);
---

<section class="marca-portada" data-fondo="oscuro">
  {/* Todas las portadas apiladas: al pasar por un logo se asoma la suya, como
      un slider. Sólo la de la marca abierta se descarga de entrada; el resto
      lleva la URL en data-src y entra al rozarla. */}
  {
    marcas.map((marca) => (
      <img
        class="marca-portada__foto"
        src={marca.slug === slug ? foto : undefined}
        data-src={marca.foto}
        alt={marca.slug === slug ? `Espacio equipado con ${activa.nombre}` : ''}
        aria-hidden={marca.slug === slug ? undefined : 'true'}
        width="1920"
        height="650"
        fetchpriority={marca.slug === slug ? 'high' : undefined}
        data-foto-de={marca.slug}
        data-activa={marca.slug === slug ? '' : undefined}
      />
    ))
  }
  <div class="marca-portada__scrim" aria-hidden="true"></div>

  {/* Pestaña y logos en una misma fila: con la pestaña posicionada aparte y
      los logos a un `left` fijo, el hueco entre ambos cambiaba según lo ancho
      que fuera cada wordmark. */}
  <div class="marca-portada__pie">
    {/* Tres piezas: los flancos llevan el canto a 18° y el centro se estira
        con el wordmark. Con un solo bloque y border-radius, los costados salían
        verticales y la pestaña no compartía el ángulo del resto del sitio. */}
    <div class="marca-portada__pestana" data-anima="portada">
      <PestanaFlanco lado="izquierda" />
      <div class="marca-portada__centro">
        <img
          class="marca-portada__wordmark"
          src={`/marcas/${activa.archivo}`}
          alt={activa.nombre}
          width={activa.ancho}
          height={activa.alto}
        />
      </div>
      <PestanaFlanco lado="derecha" />
    </div>

    <nav class="marca-portada__otras" aria-label="Otras marcas">
      {
        otras.map((marca) => (
          <a href={`/marcas/${marca.slug}`} data-asoma={marca.slug}>
            {/* Sobre la foto va la versión blanca oficial. */}
            <img
              src={`/marcas/${marca.blanco}`}
              alt={marca.nombre}
              width={marca.ancho}
              height={marca.alto}
              loading="lazy"
            />
          </a>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .marca-portada {
    --radio: clamp(1.75rem, 3.2vw, 3.5rem);

    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(70vh, 42rem);
    color: #fff;
    background: #2d2d2d;
  }

  .marca-portada__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.55s ease;
  }

  /* La que se va queda opaca por debajo hasta que la nueva termina de entrar:
     cruzando ambas a la vez, en el punto medio ninguna cubre del todo y se
     transparenta el fondo. */
  .marca-portada__foto[data-saliente] {
    opacity: 1;
    z-index: 0;
    transition: none;
  }

  .marca-portada__foto[data-activa] {
    opacity: 1;
    z-index: 1;
  }

  /* La banda baja se oscurece más: ahí van los logos blancos y con fotos
     claras (Trisoft, Belgotex) se perdían del todo. */
  /* Orden de capas: fotos (0 y 1), degradado (2) y el pie encima (3). Al dar
     z-index a la foto activa quedaba por delante del pie, que estaba en auto, y
     tapaba la pestaña y los logos. */
  .marca-portada__scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.22) 0%,
      rgba(0, 0, 0, 0.06) 40%,
      rgba(0, 0, 0, 0.34) 72%,
      rgba(0, 0, 0, 0.62) 100%
    );
  }

  /* La fila del pie ocupa el ancho y reparte: pestaña a la izquierda, logos
     llenando lo que queda hasta el canto derecho. */
  .marca-portada__pie {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    width: 100%;
  }

  /* Las marcas inactivas arrancan justo a la derecha de la pestaña —el diseño
     las quiere pegadas a ella, no descolgadas— y se reparten hasta el borde.
     Cuando no caben, la fila hace de slider. */
  .marca-portada__otras {
    flex: 1;
    display: flex;
    /* Los logos se apoyan en la misma línea de base que el wordmark de la
       pestaña: por eso el padding inferior es el mismo que el suyo. */
    align-items: flex-end;
    /* Agrupados con separación pareja en vez de repartidos por todo el ancho:
       con space-between quedaban sueltos y desordenados. */
    justify-content: flex-start;
    gap: clamp(1.25rem, 3.4vw, 3.5rem);
    padding: 0 clamp(1.5rem, 3vw, 3rem) clamp(1.1rem, 2.2vw, 2.1rem)
      clamp(1rem, 2.5vw, 2.5rem);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .marca-portada__otras::-webkit-scrollbar {
    display: none;
  }

  .marca-portada__otras a {
    flex: 0 0 auto;
    scroll-snap-align: center;
  }

  .marca-portada__otras img {
    /* Una pizca más grandes, ahora que están agrupados y no repartidos. */
    width: clamp(3.25rem, 6.2vw, 6.5rem);
    height: auto;
    opacity: 0.72;
    /* Son logos blancos sobre foto: el degradado general no basta cuando la
       imagen tiene claros justo detrás (Trisoft, Belgotex). La sombra los
       despega de cualquier fondo. */
    filter: drop-shadow(0 1px 7px rgba(0, 0, 0, 0.6));
    transition: opacity 0.25s ease;
  }

  .marca-portada__otras a:hover img {
    opacity: 0.9;
  }

  /* Pestaña de carpeta. La altura es fija a propósito: los flancos derivan su
     ancho de ella para mantener el ángulo, así que no puede depender de lo alto
     que resulte el wordmark de cada marca. */
  .marca-portada__pestana {
    --alto-pestana: clamp(4rem, 6.2vw, 6.2rem);

    position: relative;
    flex: none;
    display: flex;
    align-items: stretch;
    height: var(--alto-pestana);
    /* El wordmark queda a la sangría del diseño, así que la pestaña arranca esa
       distancia menos lo que ocupa su flanco; el max() evita que el flanco se
       salga de pantalla cuando la sangría es menor que él. */
    margin-left: max(0px, calc(10.6vw - var(--alto-pestana) * 103.02 / 165));
  }

  /* El blanco de en medio; los flancos traen el suyo en el propio trazado. */
  .marca-portada__centro {
    display: grid;
    place-items: center;
    /* 1px de solape a cada lado: el borde del SVG y el del div son dos blancos
       distintos al antialiasarse y dejaban una costura vertical. */
    margin-inline: -1px;
    padding-inline: clamp(0.5rem, 1.2vw, 1.25rem);
    background: #fff;
  }

  .marca-portada__wordmark {
    display: block;
    width: clamp(5.5rem, 10.5vw, 10.5rem);
    /* Con altura de pestaña fija, los wordmarks más altos se ajustan solos en
       vez de desbordarla. */
    max-height: calc(var(--alto-pestana) - clamp(1.1rem, 2.2vw, 2.1rem) * 2);
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 860px) {
    .marca-portada {
      min-height: min(60vh, 30rem);
    }

    /* No caben seis logos junto a la pestaña: se van sobre la foto, arriba, y
       corren en horizontal. */
    .marca-portada__pie {
      display: block;
    }

    .marca-portada__otras {
      position: absolute;
      right: 0;
      left: 0;
      top: clamp(5rem, 12vh, 7rem);
      justify-content: flex-start;
      max-width: 100%;
      padding: 0 clamp(1.5rem, 6vw, 2.5rem);
    }

    .marca-portada__otras::-webkit-scrollbar {
      display: none;
    }

    .marca-portada__otras img {
      width: 4.25rem;
    }

    .marca-portada__pestana {
      --alto-pestana: clamp(4.5rem, 22vw, 7rem);
      margin-left: max(0px, calc(8vw - var(--alto-pestana) * 103.02 / 165));
    }
  }
</style>

<script>
  // Al pasar por un logo se asoma su portada, como un slider; al salir vuelve
  // la de la marca abierta. La foto entrante se espera a estar pintable antes
  // de cruzarla: activarla sin haber cargado deja la sección en negro un
  // instante, que es lo que se ve como parpadeo.
  function montarPortadaMarca() {
    const seccion = document.querySelector<HTMLElement>('.marca-portada');
    if (!seccion) return;

    const fotos = Array.from(seccion.querySelectorAll<HTMLImageElement>('[data-foto-de]'));
    const enlaces = Array.from(seccion.querySelectorAll<HTMLElement>('[data-asoma]'));
    const inicial = fotos.find((f) => f.hasAttribute('data-activa'))?.dataset.fotoDe;
    if (!inicial) return;

    let turno = 0;
    let limpiar: ReturnType<typeof setTimeout> | undefined;

    const lista = async (img: HTMLImageElement | undefined) => {
      if (!img) return;
      if (!img.src && img.dataset.src) img.src = img.dataset.src;
      if (img.complete && img.naturalWidth > 0) return;
      try {
        await img.decode();
      } catch {
        /* imagen rota o cancelada: seguimos igual */
      }
    };

    const asomar = async (slug: string) => {
      const mio = ++turno;
      const entrante = fotos.find((f) => f.dataset.fotoDe === slug);
      if (!entrante || entrante.hasAttribute('data-activa')) return;

      await lista(entrante);
      if (mio !== turno) return;

      const saliente = fotos.find((f) => f.hasAttribute('data-activa'));
      if (saliente && saliente !== entrante) saliente.setAttribute('data-saliente', '');
      for (const f of fotos) f.toggleAttribute('data-activa', f === entrante);

      clearTimeout(limpiar);
      limpiar = setTimeout(() => {
        for (const f of fotos) if (f !== entrante) f.removeAttribute('data-saliente');
      }, 600);
    };

    for (const enlace of enlaces) {
      const slug = enlace.dataset.asoma!;
      enlace.addEventListener('pointerenter', () => asomar(slug));
      enlace.addEventListener('focus', () => asomar(slug));
      enlace.addEventListener('pointerleave', () => asomar(inicial));
      enlace.addEventListener('blur', () => asomar(inicial));
    }
  }

  montarPortadaMarca();
  document.addEventListener('astro:page-load', montarPortadaMarca);
</script>

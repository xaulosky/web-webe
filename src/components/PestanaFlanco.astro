---
// Flanco de una pestaña: el mismo perfil del escalón del hero —arco cóncavo
// abajo, recta a 18° de la vertical y arco convexo arriba— para que todas las
// pestañas del sitio compartan el ángulo del diseño (108° de interior).
//
// Va como SVG de proporción intacta y ancho derivado del alto, no estirado: con
// preserveAspectRatio="none" sobre una caja libre, el ángulo cambiaría con cada
// pestaña según lo ancho que fuera su wordmark.
interface Props {
  lado: 'izquierda' | 'derecha';
  color?: string;
  /** `trazo` dibuja sólo el canto, para las pestañas que son un contorno. */
  variante?: 'relleno' | 'trazo';
  class?: string;
}

const { lado, color = '#fff', variante = 'relleno', class: clase } = Astro.props;

// Perfil calculado para 18°: los arcos giran los 72° que faltan desde la
// tangente horizontal, de ahí los puntos de empalme. El relleno cierra la
// figura por el costado interior; el trazo se queda en la línea.
const perfil = {
  izquierda: 'M0,165 A34,34 0 0 0 32.34,141.51 L70.68,23.49 A34,34 0 0 1 103.02,0',
  derecha: 'M103.02,165 A34,34 0 0 1 70.68,141.51 L32.34,23.49 A34,34 0 0 0 0,0',
};

const cierre = { izquierda: ' L103.02,165 Z', derecha: ' L0,165 Z' };
const d = perfil[lado] + (variante === 'relleno' ? cierre[lado] : '');
---

<svg
  class:list={['flanco', clase]}
  viewBox="0 0 103.02 165"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d={d}
    fill={variante === 'relleno' ? color : 'none'}
    stroke={variante === 'trazo' ? color : undefined}
    stroke-width={variante === 'trazo' ? 1 : undefined}
    vector-effect={variante === 'trazo' ? 'non-scaling-stroke' : undefined}
  ></path>
</svg>

<style>
  .flanco {
    display: block;
    /* La proporción la fija el propio elemento: el ancho sale del alto y el
       ángulo queda en 18° sin depender de ninguna variable de fuera. */
    height: 100%;
    aspect-ratio: 103.02 / 165;
    width: auto;
    flex: none;
  }
</style>

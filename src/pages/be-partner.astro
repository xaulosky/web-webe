---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
import SeccionSobreCorte from '../components/SeccionSobreCorte.astro';
import ContactForm from '../components/ContactForm.astro';
---

{/* La página se queda sólo con el formulario: el proceso, los atributos y la
    banda de clientes que había en medio viven en otras páginas y aquí sólo
    alejaban del formulario, que es lo único que se viene a hacer. */}
<Base
  title="Seamos partners"
  description="Acompañamos a arquitectos, interioristas y empresas en el equipamiento de sus espacios de trabajo."
  header="overlay"
>
  <HeroPagina
    imagen="/portadas/partners.webp"
    alt="Reunión de trabajo en una oficina equipada por WEBE"
    ancho={1920}
    alto={1080}
    lineas={[{ fuerte: 'Seamos' }, { suave: 'partners' }]}
  />

  {/* El mismo escalón que separa el hero de la home: el blanco entra por
      encima de la portada en vez de cortar en recto. */}
  <SeccionSobreCorte id="postular">
    <div class="postular">
      <div class="postular__encabezado" data-anima="grupo">
        <h2>
          Hablemos de tu proyecto<br />
          y de cómo podemos aportar
        </h2>
        <p>
          Acompañamos a arquitectos, interioristas y empresas en el equipamiento
          de sus espacios de trabajo. Déjanos tus datos y cuéntanos qué tienes
          en mente: mientras antes conversemos, más podemos sumar en las
          decisiones de plazo, presupuesto y equipamiento.
        </p>
      </div>

      <div class="postular__formulario" data-anima>
        <ContactForm origen="be-partner" />
      </div>
    </div>
  </SeccionSobreCorte>

  <SeccionContacto />
</Base>

<style>
  /* Texto a la izquierda y formulario a la derecha, con la misma sangría que el
     resto del sitio. Sin las secciones de en medio el bloque respira más. */
  /* El contenido va dentro del envoltorio del escalón, así que el grid se
     aplica ahí; el padding superior deja pasar la diagonal por encima. */
  .postular {
    display: grid;
    /* 46%, no 38: con el titular a su cuerpo nuevo, en la columna estrecha se
       partía en cuatro líneas en vez de las dos que marcan sus saltos. */
    grid-template-columns: 46% 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    /* La sangría es la del titular de la portada (17,2vw): el «Hablemos de tu
       proyecto» arranca al mismo nivel que «Seamos partners», y con la misma
       holgura que este respecto al logo del encabezado. */
    padding: clamp(7rem, 16vw, 16rem) clamp(1.5rem, 8vw, 8rem) clamp(4rem, 9vw, 9rem)
      clamp(1.5rem, 17.2vw, 19rem);
  }

  .postular h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.35vw, 2.2rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .postular__encabezado p {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    max-width: 34ch;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* Se apila antes que a 960: entre esa medida y 1080 la columna del titular se
     quedaba corta y lo partía en tres líneas. */
  @media (max-width: 1080px) {
    .postular {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .postular {
      /* Sólo el aire bajo el escalón: el hueco que deja pasar la diagonal lo
         pone ahora el propio envoltorio, y sumados los dos el texto quedaba
         descolgado media pantalla. */
      padding-top: clamp(2rem, 7vw, 3rem);
      padding-inline: clamp(1.5rem, 6vw, 2.5rem);
    }
  }
</style>

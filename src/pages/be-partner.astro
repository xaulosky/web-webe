---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
import ContactForm from '../components/ContactForm.astro';
---

{/* La página se queda sólo con el formulario: el proceso, los atributos y la
    banda de clientes que había en medio viven en otras páginas y aquí sólo
    alejaban del formulario, que es lo único que se viene a hacer. */}
<Base
  title="Seamos partners"
  description="Acompañamos a arquitectos, interioristas y empresas en el desarrollo integral de proyectos de equipamiento para oficinas."
  header="overlay"
>
  <HeroPagina
    imagen="/proyectos/fotos/ccu-1.webp"
    alt="Sala de reuniones equipada por WEBE"
    ancho={1920}
    alto={900}
    lineas={[{ fuerte: 'Seamos' }, { suave: 'partners' }]}
  />

  <section class="postular" id="postular">
    <div class="postular__encabezado" data-anima="grupo">
      <h2>
        Hablemos de tu proyecto<br />
        y de cómo podemos aportar
      </h2>
      <p>
        Acompañamos a arquitectos, interioristas y empresas en el desarrollo
        integral de proyectos de equipamiento para oficinas. Déjanos tus datos y
        una idea de lo que necesitas: cuanto antes conversemos, más podemos
        aportar en decisiones de plazo, presupuesto y equipamiento.
      </p>
    </div>

    <div class="postular__formulario" data-anima>
      <ContactForm origen="be-partner" />
    </div>
  </section>

  <SeccionContacto />
</Base>

<style>
  /* Texto a la izquierda y formulario a la derecha, con la misma sangría que el
     resto del sitio. Sin las secciones de en medio el bloque respira más. */
  .postular {
    display: grid;
    grid-template-columns: 38% 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    padding: clamp(4rem, 9vw, 9rem) clamp(1.5rem, 8vw, 8rem) clamp(4rem, 9vw, 9rem)
      clamp(1.5rem, 16.7vw, 18rem);
  }

  .postular h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .postular__encabezado p {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    max-width: 34ch;
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-muted);
  }

  @media (max-width: 960px) {
    .postular {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .postular {
      padding-inline: clamp(1.5rem, 6vw, 2.5rem);
    }
  }
</style>

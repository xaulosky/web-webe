---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
---

<Base title="Contacto" description="Escríbenos y te respondemos a la brevedad.">
  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-14 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Contacto</h1>
        <p class="mt-4 text-muted">
          Completa el formulario y te respondemos dentro del día hábil
          siguiente. También puedes escribirnos directamente.
        </p>

        <dl class="mt-10 space-y-5 text-sm">
          <div>
            <dt class="font-medium">Email</dt>
            <dd class="mt-1">
              <a href={`mailto:${site.email}`} class="text-brand-700 hover:underline">
                {site.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-medium">Teléfono</dt>
            <dd class="mt-1">
              <a
                href={`tel:${site.phone.replace(/\s/g, '')}`}
                class="text-brand-700 hover:underline"
              >
                {site.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-medium">Dirección</dt>
            <dd class="mt-1 text-muted">{site.address}</dd>
          </div>
        </dl>
      </div>

      <div class="rounded-2xl border border-black/5 bg-white p-7 shadow-sm sm:p-9">
        <ContactForm />
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada">
  <section class="container-page py-28 text-center">
    <p class="text-sm font-medium text-brand-600">Error 404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
      No encontramos esta página
    </h1>
    <p class="mx-auto mt-4 max-w-md text-muted">
      Puede que el enlace esté roto o que la página se haya movido.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-brand-700 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-800"
    >
      Volver al inicio
    </a>
  </section>
</Base>

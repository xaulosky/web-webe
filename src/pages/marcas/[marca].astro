---
import Base from '../../layouts/Base.astro';
import HeroMarca from '../../components/HeroMarca.astro';
import SeccionContacto from '../../components/SeccionContacto.astro';
import Flecha from '../../components/Flecha.astro';
import BotonDescarga from '../../components/BotonDescarga.astro';
import { marcas } from '../../config/site';

export function getStaticPaths() {
  return marcas.map((marca) => ({ params: { marca: marca.slug }, props: { marca } }));
}

const { marca } = Astro.props;

// La portada es la imagen 1 de la marca y va a sangre arriba; la galería son
// las cinco, esa incluida.
const fotos = marca.fotos.length > 0 ? marca.fotos : [];
const portada = marca.foto || '/marcas/fotos/novara-1.webp';
---

<Base
  title={marca.nombre}
  description={marca.descripcion}
  header="overlay"
>
  <HeroMarca slug={marca.slug} foto={portada} />

  <section class="marca" data-anima="grupo">
    <div class="marca__meta">
      <div>
        <p class="marca__rotulo">Partner</p>
        <p class="marca__dato">{marca.nombre}</p>
      </div>

      {
        marca.categorias.length > 0 && (
          <div>
            {/* Unas marcas listan mobiliario y otras equipamiento. */}
            <p class="marca__rotulo">{marca.rotuloCategorias}</p>
            <ul class="marca__lista">
              {marca.categorias.map((categoria) => (
                <li>{categoria}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <p class="marca__texto">{marca.descripcion || 'Descripción pendiente.'}</p>

    <div class="marca__catalogo">
      <p class="marca__rotulo">{marca.catalogo.etiqueta}</p>
      <BotonDescarga href={marca.catalogo.archivo} inactivo={!marca.catalogo.archivo} />
    </div>
  </section>

  <div class="galeria" data-anima>
    <div class="galeria__marco">
      {
        fotos.map((url, i) => (
          <img
            src={url}
            alt={`${marca.nombre} — imagen ${i + 1}`}
            width="1200"
            height="960"
            loading="lazy"
            decoding="async"
            data-foto={i}
            data-activa={i === 0 ? '' : undefined}
          />
        ))
      }

      {
        fotos.length > 1 && (
          <div class="galeria__puntos" role="tablist" aria-label="Imágenes">
            {fotos.map((_, i) => (
              <button
                type="button"
                role="tab"
                data-ir={i}
                aria-selected={i === 0}
                aria-label={`Imagen ${i + 1}`}
              />
            ))}
          </div>
        )
      }
    </div>
  </div>

  <p class="volver">
    <a href="/">
      <Flecha class="volver__flecha" />
      Regresar a WEBE
    </a>
  </p>

  <SeccionContacto />
</Base>

<style>
  .marca {
    display: grid;
    grid-template-columns: 16% 46% 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding: clamp(3rem, 6vw, 6rem) clamp(1.5rem, 4vw, 4rem) clamp(2rem, 5vw, 5rem)
      clamp(1.5rem, 10vw, 11rem);
  }

  .marca__meta {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-content: start;
  }

  .marca__rotulo {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .marca__dato,
  .marca__lista li {
    font-size: clamp(0.9rem, 1.05vw, 1.05rem);
    font-weight: 300;
    line-height: 1.65;
  }

  .marca__dato {
    margin: 0;
  }

  .marca__texto {
    margin: 0;
    font-size: clamp(1.1rem, 1.72vw, 1.6rem);
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .marca__catalogo {
    align-content: start;
  }

  /* Mismas columnas que la ficha: la galería arranca donde arranca el texto,
     no centrada en la página. */
  .galeria {
    display: grid;
    grid-template-columns: 16% 46% 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-inline: clamp(1.5rem, 10vw, 11rem) clamp(1.5rem, 8vw, 8rem);
    padding-bottom: clamp(2rem, 5vw, 5rem);
  }

  .galeria__marco {
    position: relative;
    grid-column: 2 / -1;
    /* Menos alta que las fotos, que son 1200×960: se recortan arriba y abajo
       en vez de imponerle su proporción a la galería. */
    aspect-ratio: 16 / 9;
    /* Algo más angosta que la columna del texto. Va como margen y no como
       padding de la sección: el padding entra en la cuenta de las columnas y
       movía también su borde izquierdo, que es el que tiene que seguir
       alineado con el párrafo de la ficha. */
    margin-right: clamp(0rem, 6vw, 7rem);
    /* Y con tope: en pantallas anchas la foto se iba a un tamaño de portada. */
    max-width: min(100%, 46rem);
  }

  /* Apiladas y absolutas: con el alto del marco saliendo de su proporción, unas
     fotos en flujo que midieran el 100% de ese alto serían un cálculo circular
     —el alto de la caja lo daría la foto y el de la foto la caja—. */
  .galeria__marco img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: clamp(1rem, 1.8vw, 1.75rem);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s ease,
      visibility 0.45s;
  }

  .galeria__marco img[data-activa] {
    opacity: 1;
    visibility: visible;
  }

  .galeria__puntos {
    position: absolute;
    bottom: clamp(0.75rem, 1.5vw, 1.25rem);
    left: 50%;
    display: flex;
    gap: 0.6rem;
    transform: translateX(-50%);
  }

  .galeria__puntos button {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .galeria__puntos button[aria-selected='true'] {
    background: #fff;
  }

  .volver {
    margin: 0;
    padding: 0 clamp(1.5rem, 4vw, 4rem) clamp(3rem, 7vw, 7rem)
      clamp(1.5rem, 10vw, 11rem);
  }

  .volver a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: gap 0.25s ease;
  }

  .volver a:hover {
    gap: 1.1rem;
  }

  .volver :global(.volver__flecha) {
    width: 1.1rem;
    opacity: 0.55;
    /* La flecha de marca apunta a la derecha; aquí se vuelve. */
    transform: scaleX(-1);
  }

  @media (max-width: 900px) {
    .marca {
      grid-template-columns: 1fr;
      gap: clamp(2rem, 7vw, 3rem);
      padding-inline: clamp(1.5rem, 6vw, 2.5rem);
    }

    /* La galería toma todo el ancho: con las tres columnas de escritorio se
       quedaba encajada en las dos de la derecha, hecha una postal. */
    .galeria {
      grid-template-columns: 1fr;
      padding-inline: clamp(1.5rem, 6vw, 2.5rem);
    }

    .galeria__marco {
      grid-column: 1 / -1;
      margin-right: 0;
      max-width: none;
    }

    .volver {
      padding-inline: clamp(1.5rem, 6vw, 2.5rem);
    }
  }
</style>

<script>
  const marco = document.querySelector<HTMLElement>('.galeria__marco');

  if (marco) {
    const fotos = Array.from(marco.querySelectorAll<HTMLElement>('[data-foto]'));
    const puntos = Array.from(marco.querySelectorAll<HTMLElement>('[data-ir]'));
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

    let actual = 0;
    let visible = false;
    let reloj = 0;

    const pintar = () => {
      for (const foto of fotos) {
        foto.toggleAttribute('data-activa', Number(foto.dataset.foto) === actual);
      }
      puntos.forEach((punto, j) =>
        punto.setAttribute('aria-selected', String(j === actual)),
      );
    };

    // Las láminas pasan solas, igual que en el slider de proyectos. El reloj
    // se reinicia con cada salto a mano: no tiene sentido cambiarle la foto
    // debajo a quien acaba de elegir una.
    const reiniciar = () => {
      window.clearInterval(reloj);
      if (sinMovimiento.matches || fotos.length < 2) return;
      reloj = window.setInterval(() => {
        if (!visible) return;
        actual = (actual + 1) % fotos.length;
        pintar();
      }, 3200);
    };

    puntos.forEach((punto, i) => {
      punto.addEventListener('click', () => {
        actual = i;
        pintar();
        reiniciar();
      });
    });

    // Sólo corre con la galería a la vista.
    const observador = new IntersectionObserver(
      ([entrada]) => {
        visible = entrada.isIntersecting;
      },
      { rootMargin: '100px' },
    );
    observador.observe(marco);

    reiniciar();
  }
</script>

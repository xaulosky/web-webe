---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import PanelSacado from '../components/PanelSacado.astro';
import Acordeon from '../components/Acordeon.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
---

<Base
  title="We are"
  description="WEBE nace de profesionales que entienden el equipamiento corporativo desde distintas miradas: diseño, operación, gestión y servicio."
  header="overlay"
>
  {/* La apaisada del showroom hace de portada en todos los anchos. Antes se
      enrocaba con la del panel, pero esa es apaisada y a sangre en celu se
      quedaba con un tercio del ancho: dejaba fuera a dos de los tres socios. */}
  <HeroPagina
    imagen="/nosotros/hero.webp"
    alt="Los tres socios de WEBE reunidos en la oficina"
    ancho={1920}
    alto={1080}
    lineas={[{ fuerte: 'Nuestro' }, { suave: 'equipo' }]}
  />

  <PanelSacado>
    {/* Los socios salen sólo aquí, y enteros en cualquier ancho. */}
    <img
      slot="izquierda"
      class="nosotros__foto nosotros__equipo"
      src="/nosotros/equipo.webp"
      alt="Los tres socios de WEBE"
      width="1600"
      height="1400"
      loading="lazy"
      decoding="async"
    />

    <p class="nosotros__creencia">
      webe nace de profesionales que entienden el equipamiento corporativo desde
      distintas miradas: diseño, operación, gestión, servicio.
    </p>

    <p class="nosotros__creencia">
      Creemos que un buen proyecto no depende solo del mobiliario, sino de cómo
      se piensa, se acompaña y se resuelve cada decisión detrás de él.
    </p>
  </PanelSacado>

  <section class="atributos">
    <Acordeon />
  </section>

  <SeccionContacto />
</Base>

<style>
  /* En línea, la foto no tendría contra qué resolver su 100% de ancho. */
  .nosotros__foto {
    display: block;
  }

  .nosotros__equipo {
    width: 100%;
    height: auto;
    /* Curva apenas insinuada: la de antes se notaba de más en la esquina. */
    border-radius: clamp(0.2rem, 0.3vw, 0.35rem);
  }

  .nosotros__creencia {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    max-width: 26ch;
    font-size: clamp(1.25rem, 2.1vw, 1.95rem);
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .atributos {
    padding-block: clamp(2.5rem, 6vw, 6rem) clamp(3rem, 7vw, 7rem);
  }

</style>

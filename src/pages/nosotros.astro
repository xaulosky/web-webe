---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import PanelSacado from '../components/PanelSacado.astro';
import Acordeon from '../components/Acordeon.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
---

<Base
  title="We are"
  description="WEBE nace de la unión de profesionales con experiencia en equipamiento corporativo."
  header="overlay"
>
  {/* Enroque pedido: en celu la portada es la vertical de los socios y la
      apaisada del showroom baja al panel. En escritorio siguen al revés: la
      vertical estirada a una portada a sangre les corta la cabeza. */}
  <HeroPagina
    imagen="/nosotros/hero.webp"
    imagenAngosta="/nosotros/equipo.webp"
    alt="Los tres socios de WEBE"
    ancho={1900}
    alto={943}
    lineas={[{ fuerte: 'Nuestro' }, { suave: 'equipo' }]}
  />

  <PanelSacado>
    <picture slot="izquierda" class="nosotros__foto">
      {/* La que no salió de portada: en celu la apaisada, en escritorio la
          vertical. */}
      <source srcset="/nosotros/hero.webp" media="(max-width: 860px)" />
      <img
        class="nosotros__equipo"
        src="/nosotros/equipo.webp"
        alt="Los socios de WEBE en el showroom"
        width="797"
        height="854"
        loading="lazy"
        decoding="async"
      />
    </picture>

    <p class="nosotros__creencia">
      webe nace de la unión de profesionales con experiencia en distintas áreas
      del equipamiento corporativo.
    </p>

    <p class="nosotros__creencia">
      Creemos que un buen proyecto no depende únicamente del mobiliario, sino de
      las decisiones que lo hacen posible.
    </p>
  </PanelSacado>

  <section class="atributos">
    <Acordeon />
  </section>

  <SeccionContacto />
</Base>

<style>
  /* Sin esto la picture es en línea y el ancho de la foto no tendría contra
     qué resolver su 100%. */
  .nosotros__foto {
    display: block;
  }

  .nosotros__equipo {
    width: 100%;
    height: auto;
    /* Curva apenas insinuada: la de antes se notaba de más en la esquina. */
    border-radius: clamp(0.2rem, 0.3vw, 0.35rem);
  }

  .nosotros__creencia {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    max-width: 26ch;
    font-size: clamp(1.25rem, 2.1vw, 1.95rem);
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .atributos {
    padding-block: clamp(2.5rem, 6vw, 6rem) clamp(3rem, 7vw, 7rem);
  }

</style>

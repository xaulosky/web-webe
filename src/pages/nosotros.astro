---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import PanelSacado from '../components/PanelSacado.astro';
import Acordeon from '../components/Acordeon.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
---

<Base
  title="Cómo Pensamos"
  description="WEBE nace de profesionales que entienden el equipamiento corporativo desde distintas miradas: diseño, operación, gestión y servicio."
  header="overlay"
>
  {/* «Cómo» va en fino y «Pensamos» en fuerte, al revés que el resto de las
      portadas: es el énfasis que pide el diseño de esta página. */}
  <HeroPagina
    imagen="/nosotros/hero.webp"
    alt="Equipo de WEBE en una reunión de trabajo"
    ancho={1920}
    alto={1081}
    lineas={[{ suave: 'Cómo' }, { fuerte: 'Pensamos' }]}
  />

  <PanelSacado>
    <img
      slot="izquierda"
      class="nosotros__foto"
      src="/nosotros/planos.webp"
      alt="Planos y muestras de materiales sobre la mesa de trabajo de WEBE"
      width="1086"
      height="1049"
      loading="lazy"
      decoding="async"
    />

    <p class="nosotros__creencia">
      Un buen proyecto no depende solo del mobiliario, sino de cómo se piensa,
      se acompaña y se resuelve cada decisión detrás de él.
    </p>

    <p class="nosotros__creencia">
      webe nace de profesionales que entienden el equipamiento corporativo desde
      distintas miradas: diseño, operación, gestión y servicio.
    </p>
  </PanelSacado>

  <section class="atributos">
    <Acordeon />
  </section>

  <SeccionContacto />
</Base>

<style>
  /* En línea, la foto no tendría contra qué resolver su 100% de ancho. */
  .nosotros__foto {
    display: block;
    width: 100%;
    height: auto;
    /* Curva apenas insinuada: la de antes se notaba de más en la esquina. */
    border-radius: clamp(0.2rem, 0.3vw, 0.35rem);
  }

  .nosotros__creencia {
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    max-width: 26ch;
    font-size: clamp(1.25rem, 2.1vw, 1.95rem);
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .atributos {
    padding-block: clamp(2.5rem, 6vw, 6rem) clamp(3rem, 7vw, 7rem);
  }

</style>

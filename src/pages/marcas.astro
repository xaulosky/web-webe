---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
import Flecha from '../components/Flecha.astro';
import { marcas } from '../config/site';

// TODO: Rossi aún no manda fotos; mientras tanto muestra la primera de Novara.
const fotoDe = (marca: (typeof marcas)[number]) =>
  marca.fotos[0] ?? '/marcas/fotos/novara-1.webp';
---

<Base
  title="Nuestras marcas"
  description="Las marcas internacionales que representamos en Chile."
  header="overlay"
>
  <HeroPagina
    imagen="/marcas/fotos/bkcontract-1.webp"
    alt="Espacio equipado con las marcas que representa WEBE"
    ancho={1920}
    alto={650}
    lineas={[{ fuerte: 'Nuestras' }, { suave: 'marcas' }]}
  />

  <section class="intro" data-anima="grupo">
    <p class="intro__texto">
      Trabajamos con marcas reconocidas por su calidad, innovación y
      confiabilidad, priorizando relaciones de largo plazo que aseguren
      continuidad y respaldo en cada proyecto.
    </p>
  </section>

  <div class="listado">
    {
      marcas.map((marca, i) => (
        <article class="marca" data-anima="grupo">
          <a class="marca__foto" href={`/marcas/${marca.slug}`}>
            <img
              src={fotoDe(marca)}
              alt={`Espacio equipado con ${marca.nombre}`}
              width="1920"
              height="650"
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>

          <div class="marca__ficha">
            <img
              class="marca__wordmark"
              src={`/marcas/${marca.archivo}`}
              alt={marca.nombre}
              width={marca.ancho}
              height={marca.alto}
              loading="lazy"
              decoding="async"
            />

            <p class="marca__texto">{marca.descripcion}</p>

            {marca.categorias.length > 0 && (
              <>
                <p class="marca__rotulo">{marca.rotuloCategorias}</p>
                <ul class="marca__lista">
                  {marca.categorias.map((categoria) => (
                    <li>{categoria}</li>
                  ))}
                </ul>
              </>
            )}

            <a class="marca__ver" href={`/marcas/${marca.slug}`}>
              Ver marca
              <Flecha />
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <SeccionContacto />
</Base>

<style>
  .intro {
    padding: clamp(3rem, 7vw, 7rem) clamp(1.5rem, 6vw, 7rem)
      clamp(2rem, 5vw, 5rem) clamp(1.5rem, 16.2vw, 18rem);
  }

  .intro__texto {
    margin: 0;
    max-width: 30ch;
    font-size: clamp(1.25rem, 2.1vw, 1.95rem);
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .listado {
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    padding: 0 clamp(1.5rem, 6vw, 7rem) clamp(4rem, 9vw, 9rem);
  }

  .marca {
    display: grid;
    grid-template-columns: 1fr 34%;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  /* Alternar el lado de la foto rompe la monotonía de la lista. Hay que dar
     vuelta también las columnas: si sólo se reordena, la foto cae en la
     columna estrecha y encoge. */
  .marca:nth-child(even) {
    grid-template-columns: 34% 1fr;
  }

  .marca:nth-child(even) .marca__foto {
    order: 2;
  }

  .marca__foto img {
    width: 100%;
    height: auto;
    border-radius: clamp(1rem, 1.8vw, 1.75rem);
    transition: opacity 0.3s ease;
  }

  .marca__foto:hover img {
    opacity: 0.88;
  }

  .marca__wordmark {
    display: block;
    width: clamp(7rem, 12vw, 12rem);
    height: auto;
  }

  .marca__texto {
    margin: clamp(1rem, 2vw, 1.75rem) 0 0;
    font-size: clamp(0.9rem, 1.02vw, 1rem);
    font-weight: 300;
    line-height: 1.7;
  }

  .marca__rotulo {
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .marca__lista li {
    font-size: clamp(0.875rem, 1vw, 0.95rem);
    font-weight: 300;
    line-height: 1.7;
  }

  .marca__ver {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: gap 0.25s ease;
  }

  .marca__ver:hover {
    gap: 1.1rem;
  }

  /* El SVG viene de un componente hijo: sin :global el estilo con ámbito no lo
     alcanza y la flecha se estira a todo el ancho disponible. */
  .marca__ver :global(.flecha) {
    width: 1.1rem;
    flex: none;
    opacity: 0.55;
  }

  @media (max-width: 900px) {
    .intro {
      padding-inline: clamp(1.5rem, 6vw, 2.5rem);
    }

    .listado {
      padding-inline: clamp(1.5rem, 6vw, 2.5rem);
    }

    .marca {
      grid-template-columns: 1fr;
    }

    /* En una columna la foto va siempre arriba. */
    .marca:nth-child(even) .marca__foto {
      order: 0;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SeccionNosotros from '../components/SeccionNosotros.astro';
import Marquesina from '../components/Marquesina.astro';
import SeccionPartner from '../components/SeccionPartner.astro';
import SeccionCita from '../components/SeccionCita.astro';
import SeccionMarcas from '../components/SeccionMarcas.astro';
import SeccionWeWork from '../components/SeccionWeWork.astro';
import SeccionProyectos from '../components/SeccionProyectos.astro';
import Clientes from '../components/Clientes.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
---

<Base header="overlay" logoMorph>
  <Hero scrollTo="#descubre" />
  <SeccionNosotros id="descubre" />
  <Marquesina />
  <SeccionPartner />
  <SeccionCita />
  <SeccionMarcas />
  <SeccionWeWork />
  <SeccionProyectos />
  <Clientes />
  <SeccionContacto />
</Base>

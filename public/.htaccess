# Configuración Apache / cPanel. Se copia tal cual a dist/ en cada build.

ErrorDocument 404 /404.html

# Forzar HTTPS (descomentar cuando el certificado SSL esté activo en cPanel).
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Los assets de Astro llevan hash en el nombre —index.BLq98QoG.css—, asi que
  # su contenido no puede cambiar sin cambiar la URL: esos si se cachean para
  # siempre. El patron exige ese hash de ocho caracteres antes de la extension.
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(js|css|woff2|woff|ttf)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>
  # Las fotos y los logos de public/ conservan su nombre entre despliegues
  # —hero.webp, planos.webp—, asi que no pueden ser immutable: esa cabecera le
  # dice al navegador que no vuelva a preguntar, y al reemplazar una foto quien
  # ya la tenia seguia viendo la antigua durante un ano. Se cachean un dia y
  # despues se revalidan; si no cambio, el servidor responde 304 y no se
  # descarga nada.
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|avif|ico|mp4|webm)$">
    ExpiresDefault "access plus 1 day"
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  # El HTML siempre se revalida para que los deploys se vean al instante.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Bloquear acceso a archivos sensibles que pudieran subirse por error.
<FilesMatch "^(\.env|\.git.*|composer\.(json|lock)|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>
